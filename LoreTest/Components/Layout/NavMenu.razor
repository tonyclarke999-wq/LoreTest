@implements IDisposable

@inject NavigationManager NavigationManager
@using LoreTest.Data
@using Microsoft.EntityFrameworkCore
@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LoreTest</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Home"]</span>
            </NavLink>
        </div>



        <div class="nav-item px-3">
            <NavLink class="nav-link" href="auth">
                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["AuthRequired"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="users">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Users"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                <span class="bi bi-folder-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Projects"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="testruns">
                <span class="bi bi-runner-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["TestRuns"]</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bugs">
                <span class="bi bi-bug-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Bugs"]</span>
            </NavLink>
        </div>

        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">@authContext.User.Identity?.Name</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Logout"]</span>
                        </button>
                    </form>
                </div>
                <AuthorizeView Roles="Administrator">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/settings">
                            <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["AdminSettings"]</span>
                        </NavLink>
                    </div>
                </AuthorizeView>
            </Authorized>
            <NotAuthorized>
                @if (!registrationDisabled)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Register">
                            <span class="bi bi-person-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Register"]</span>
                        </NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> <span class="nav-text">@L["Login"]</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private bool registrationDisabled = false;

    [Inject]
    private IDbContextFactory<ApplicationDbContext> DbFactory { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        using var dbContext = await DbFactory.CreateDbContextAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var validAdmins = await dbContext.Users
            .Where(u => u.Role == "Administrator")
            .ToListAsync();
            
        var currentAdmins = validAdmins.Where(u => 
            (u.StartDate == null || u.StartDate <= today) && 
            (u.EndDate == null || u.EndDate >= today))
            .ToList();

        if (currentAdmins.Any())
        {
            registrationDisabled = true;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

