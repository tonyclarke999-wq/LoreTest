@implements IDisposable

@inject NavigationManager NavigationManager
@using LoreTest.Data
@using Microsoft.EntityFrameworkCore
@inject IStringLocalizer<SharedResource> L

<div class="sidebar">
    <a class="navbar-brand" href="">LoreTest</a>
    
    <nav class="flex-column mt-3 h-100 d-flex">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="material-symbols-outlined">dashboard</span> <span class="nav-text">@L["Home"]</span>
        </NavLink>
        
        <NavLink class="nav-link" href="projects">
            <span class="material-symbols-outlined">folder</span> <span class="nav-text">@L["Projects"]</span>
        </NavLink>
        
        <NavLink class="nav-link" href="testruns">
            <span class="material-symbols-outlined">play_circle</span> <span class="nav-text">@L["TestRuns"]</span>
        </NavLink>
        
        <NavLink class="nav-link" href="bugs">
            <span class="material-symbols-outlined">bug_report</span> <span class="nav-text">@L["Bugs"]</span>
        </NavLink>

        <div class="mt-auto pb-4">
            <AuthorizeView Context="authContext">
                <Authorized>
                    @if (authContext.User.IsInRole("Administrator"))
                    {
                        <NavLink class="nav-link" href="users">
                            <span class="material-symbols-outlined">group</span> <span class="nav-text">@L["Users"]</span>
                        </NavLink>
                        <NavLink class="nav-link" href="admin/audit-report">
                            <span class="material-symbols-outlined">shield_person</span> <span class="nav-text">@L["AuditReport"]</span>
                        </NavLink>
                        <NavLink class="nav-link" href="admin/settings">
                            <span class="material-symbols-outlined">settings</span> <span class="nav-text">@L["AdminSettings"]</span>
                        </NavLink>
                    }
                    
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="material-symbols-outlined">account_circle</span> <span class="nav-text">@authContext.User.Identity?.Name</span>
                    </NavLink>

                    <form action="Account/Logout" method="post" class="mt-1">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                            <span class="material-symbols-outlined">logout</span> <span class="nav-text">@L["Logout"]</span>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="material-symbols-outlined">login</span> <span class="nav-text">@L["Login"]</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    private string? currentUrl;
    private bool registrationDisabled = false;

    [Inject]
    private IDbContextFactory<ApplicationDbContext> DbFactory { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        using var dbContext = await DbFactory.CreateDbContextAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var validAdmins = await dbContext.Users
            .Where(u => u.Role == "Administrator")
            .ToListAsync();
            
        var currentAdmins = validAdmins.Where(u => 
            (u.StartDate == null || u.StartDate <= today) && 
            (u.EndDate == null || u.EndDate >= today))
            .ToList();

        if (currentAdmins.Any())
        {
            registrationDisabled = true;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

