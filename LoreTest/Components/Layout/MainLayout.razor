@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L

<div class="app-container">
    <NavMenu />

    <div class="main-wrapper">
        <header class="top-header">
            <div class="d-flex justify-content-end align-items-center w-100">
                <div class="d-flex align-items-center">
                    <CultureSelector />
                    <AuthorizeView>
                        <Authorized>
                            <a href="Account/Manage" class="ms-3 d-flex align-items-center text-decoration-none">
                                <span class="material-symbols-outlined me-1 text-muted" style="font-size: 20px;">account_circle</span>
                                <span class="body-md text-muted">@context.User.Identity?.Name</span>
                            </a>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["UnhandledError"]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
