@page "/testcases/delete/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["DeleteTestCase"]</PageTitle>

<h1>@L["DeleteTestCase"]</h1>

@if (!canEdit)
{
    <p>@L["NoPermissionDeleteTestCase"]</p>
}
else if (testCase == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <h3>@L["DeleteConfirmationGeneral"]</h3>
    <div>
        <h4>@L["TestCase"]</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@L["Title"]</dt>
            <dd class="col-sm-9">@testCase.Title</dd>
            
            <dt class="col-sm-3">@L["Description"]</dt>
            <dd class="col-sm-9">@((MarkupString)(testCase.Description ?? ""))</dd>
            
            <dt class="col-sm-3">@L["Status"]</dt>
            <dd class="col-sm-9">@testCase.Status</dd>
        </dl>
        
        <EditForm Model="testCase" OnValidSubmit="DeleteTestCase" FormName="deleteTestCase">
            <button type="submit" class="btn btn-danger">@L["Delete"]</button> |
            <a href="/testsuites/details/@testCase.TestSuiteId">@L["BackToTestSuite"]</a>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TestCase? testCase;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        testCase = await DbContext.TestCases.FirstOrDefaultAsync(m => m.Id == Id);

        if (testCase == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private async Task DeleteTestCase()
    {
        if (canEdit && testCase != null)
        {
            DbContext.TestCases.Remove(testCase);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo($"/testsuites/details/{testCase.TestSuiteId}");
        }
    }
}
