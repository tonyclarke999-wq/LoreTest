@page "/testcases/details/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["TestCaseDetails"]</PageTitle>

@if (testCase == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
<div class="d-flex justify-content-between align-items-start mb-1">
    <div>
        <div class="headline-md">@testCase.Title</div>
        <div class="body-sm text-muted mt-1">
            ID: <span class="data-mono">@testCase.Id</span> &nbsp;|&nbsp; 
            @L["Suite"]: <a href="/testsuites/details/@testCase.TestSuiteId" class="text-decoration-none fw-bold">@testCase.TestSuite?.Title</a>
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge-custom" data-priority="@(testCase.Priority ?? "Low")">@L[testCase.Priority ?? "Low"]</span>
        <span class="badge-custom" data-status="@(testCase.Status ?? "Pending")">@L[testCase.Status ?? "Pending"]</span>
        @if (canEdit)
        {
            <div class="ms-3 d-flex gap-2">
                <a href="/testcases/edit/@testCase.Id" class="btn btn-outline-primary btn-sm d-flex align-items-center">
                    <span class="material-symbols-outlined small me-1">edit</span> @L["EditCase"]
                </a>
                <a href="/testcases/delete/@testCase.Id" class="btn btn-outline-danger btn-sm d-flex align-items-center">
                    <span class="material-symbols-outlined small me-1">delete</span> @L["DeleteCase"]
                </a>
            </div>
        }
    </div>
</div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "details" ? "active" : "")"
                    @onclick='() => activeTab = "details"'>
                @L["CaseDetails"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "steps" ? "active" : "")"
                    @onclick='() => activeTab = "steps"'>
                @L["TestSteps"]
                @if (testCase.TestSteps.Any())
                {
                    <span class="badge bg-secondary ms-1">@testCase.TestSteps.Count</span>
                }
            </button>
        </li>
    </ul>

    <!-- Tab: Case Details -->
    @if (activeTab == "details")
    {
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["Overview"]</strong></div>
                    <div class="card-body">
                        <p><strong>@L["IdRef"]:</strong> @testCase.Id</p>
                        <p><strong>@L["Priority"]:</strong> @L[testCase.Priority ?? "Low"]</p>
                        <p><strong>@L["Status"]:</strong> @L[testCase.Status ?? "Pending"]</p>
                        @if (!string.IsNullOrWhiteSpace(testCase.DefectId))
                        {
                            <p><strong>@L["DefectId"]:</strong> @testCase.DefectId</p>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["Description"]</strong></div>
                    <div class="card-body">
                        @((MarkupString)(testCase.Description ?? $"<em class='text-muted'>{L["None"]}</em>"))
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["Notes"]</strong></div>
                    <div class="card-body">
                        @((MarkupString)(testCase.Notes ?? $"<em class='text-muted'>{L["None"]}</em>"))
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["PreConditions"]</strong></div>
                    <div class="card-body">
                        @((MarkupString)(testCase.PreConditions ?? $"<em class='text-muted'>{L["None"]}</em>"))
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["Dependencies"]</strong></div>
                    <div class="card-body">
                        @((MarkupString)(testCase.Dependencies ?? $"<em class='text-muted'>{L["None"]}</em>"))
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["TestData"]</strong></div>
                    <div class="card-body">
                        @((MarkupString)(testCase.TestData ?? $"<em class='text-muted'>{L["None"]}</em>"))
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light"><strong>@L["PostCondition"]</strong></div>
                    <div class="card-body">
                        @((MarkupString)(testCase.PostCondition ?? $"<em class='text-muted'>{L["None"]}</em>"))
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Tab: Test Steps -->
    @if (activeTab == "steps")
    {
        <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
            <div class="title-sm">@L["StepsForThisCase"]</div>
            @if (canEdit)
            {
                <a href="/teststeps/create?testCaseId=@testCase.Id" class="btn btn-primary btn-sm d-flex align-items-center">
                    <span class="material-symbols-outlined small me-1">add</span> @L["AddStep"]
                </a>
            }
        </div>

        @if (!testCase.TestSteps.Any())
        {
            <div class="card p-5 text-center text-muted border-dashed">
                <span class="material-symbols-outlined display-lg d-block mb-2 opacity-25">format_list_numbered</span>
                <div class="body-md">@L["NoStepsAdded"] @(canEdit ? L["ClickAddStep"] : "")</div>
            </div>
        }
        else
        {
            <div class="card p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 80px">#</th>
                                <th>@L["StepDescription"]</th>
                                <th>@L["ExpectedResult"]</th>
                                @if (canEdit)
                                {
                                    <th class="text-end" style="width: 120px">@L["Actions"]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var step in testCase.TestSteps.OrderBy(s => s.StepNumber))
                            {
                                <tr>
                                    <td class="data-mono fw-bold">@step.StepNumber</td>
                                    <td class="body-md">@((MarkupString)(step.Description ?? ""))</td>
                                    <td class="body-md">@((MarkupString)(step.ExpectedResult ?? ""))</td>
                                    @if (canEdit)
                                    {
                                        <td class="text-end pe-3">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="/teststeps/edit/@step.Id" class="btn btn-sm btn-outline-primary" title="@L["Edit"]">
                                                    <span class="material-symbols-outlined small">edit</span>
                                                </a>
                                                <a href="/teststeps/delete/@step.Id" class="btn btn-sm btn-outline-danger" title="@L["Delete"]">
                                                    <span class="material-symbols-outlined small">delete</span>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }

    <div class="mt-5 mb-5 border-top pt-4">
        <a href="/testsuites/details/@testCase.TestSuiteId" class="btn btn-outline-primary d-inline-flex align-items-center">
            <span class="material-symbols-outlined small me-2">arrow_back</span> @L["BackToTestSuite"]
        </a>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    private TestCase? testCase;
    private bool canEdit = false;
    private string activeTab = "details";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        // Default to steps tab if arriving back from step CRUD pages
        if (TabParam == "steps")
        {
            activeTab = "steps";
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        testCase = await DbContext.TestCases
            .Include(tc => tc.TestSteps)
            .Include(tc => tc.TestSuite)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (testCase == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private static string StatusBadge(string? status) => status switch
    {
        "Pass" => "bg-success",
        "Fail" => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private static string PriorityBadge(string? priority) => priority switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
