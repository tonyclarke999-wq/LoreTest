@page "/testruns/details/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Test Run Details</PageTitle>

@if (testRun == null)
{
    <p><em>Loading details...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Run #@testRun.RunNumber Details</h1>
        <div>
            @if (testRun.Status != "Completed" && canEdit)
            {
                <a href="/testruns/execute/@testRun.Id" class="btn btn-success">Resume Execution</a>
            }
            <a href="/testruns" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Summary</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Project:</dt>
                        <dd class="col-sm-7">@testRun.Project?.Title</dd>
                        
                        <dt class="col-sm-5">Suite:</dt>
                        <dd class="col-sm-7">@testRun.TestSuite?.Title</dd>
                        
                        <dt class="col-sm-5">Status:</dt>
                        <dd class="col-sm-7">
                             <span class="badge @(testRun.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@testRun.Status</span>
                        </dd>
                        
                        <dt class="col-sm-5">Started By:</dt>
                        <dd class="col-sm-7">@testRun.User?.Name</dd>
                        
                        <dt class="col-sm-5">Started:</dt>
                        <dd class="col-sm-7 small">@testRun.StartTime.ToLocalTime().ToString("g")</dd>
                        
                        @if (testRun.EndTime.HasValue)
                        {
                            <dt class="col-sm-5">Finished:</dt>
                            <dd class="col-sm-7 small">@testRun.EndTime.Value.ToLocalTime().ToString("g")</dd>
                            
                            <dt class="col-sm-5">Duration:</dt>
                            <dd class="col-sm-7 small">@((testRun.EndTime.Value - testRun.StartTime).ToString(@"hh\:mm\:ss"))</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100 shadow-sm text-center p-3">
                <div class="card-body d-flex flex-column justify-content-center">
                    @{
                        var totalCases = testRun.CaseResults.Count;
                        var passedCases = testRun.CaseResults.Count(c => c.Status == "Pass");
                        var failedCases = testRun.CaseResults.Count(c => c.Status == "Fail");
                        var pendingCases = totalCases - passedCases - failedCases;
                        var passRate = totalCases > 0 ? (int)((double)passedCases / totalCases * 100) : 0;
                    }
                    <h2 class="display-4 fw-bold @(passRate == 100 ? "text-success" : passRate > 50 ? "text-warning" : "text-danger")">@passRate% Pass Rate</h2>
                    <div class="progress mt-3 mb-4" style="height: 30px;">
                        <div class="progress-bar bg-success" style="width: @(totalCases > 0 ? passedCases * 100 / totalCases : 0)%">@passedCases Pass</div>
                        <div class="progress-bar bg-danger" style="width: @(totalCases > 0 ? failedCases * 100 / totalCases : 0)%">@failedCases Fail</div>
                        <div class="progress-bar bg-secondary" style="width: @(totalCases > 0 ? pendingCases * 100 / totalCases : 0)%">@pendingCases Other</div>
                    </div>
                    <div class="row mt-2">
                        <div class="col">
                            <h4 class="mb-0 text-success">@passedCases</h4>
                            <small class="text-muted">PASSED</small>
                        </div>
                        <div class="col">
                            <h4 class="mb-0 text-danger">@failedCases</h4>
                            <small class="text-muted">FAILED</small>
                        </div>
                        <div class="col">
                            <h4 class="mb-0 text-secondary">@totalCases</h4>
                            <small class="text-muted">TOTAL CASES</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h3>Case Details</h3>
    @foreach (var cr in testRun.CaseResults)
    {
        <div class="card mb-3 border-start border-4 @(cr.Status == "Pass" ? "border-success" : cr.Status == "Fail" ? "border-danger" : "border-warning")">
            <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor: pointer" @onclick="() => ToggleCaseCollapse(cr.Id)">
                <h5 class="mb-0">
                    <span class="me-2">@(collapsedCases.Contains(cr.Id) ? "▶" : "▼")</span>
                    @cr.TestCase?.Title
                </h5>
                <div>
                    @if (cr.Status == "Pass") { <span class="badge bg-success">PASS</span> }
                    else if (cr.Status == "Fail") { <span class="badge bg-danger">FAIL</span> }
                    else { <span class="badge bg-warning text-dark">@cr.Status</span> }
                </div>
            </div>
            
            @if (!collapsedCases.Contains(cr.Id))
            {
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 30%">Step Description</th>
                                <th style="width: 25%">Expected Result</th>
                                <th style="width: 25%">Actual Result</th>
                                <th style="width: 15%">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sr in cr.StepResults.OrderBy(s => s.TestStep?.StepNumber))
                            {
                                <tr>
                                    <td class="fw-bold">@sr.TestStep?.StepNumber</td>
                                    <td>@((MarkupString)(sr.TestStep?.Description ?? ""))</td>
                                    <td>@((MarkupString)(sr.TestStep?.ExpectedResult ?? ""))</td>
                                    <td class="text-break">
                                        @if (canEdit && testRun.Status != "Completed")
                                        {
                                            <div class="input-group input-group-sm">
                                                <input type="text" class="form-control" @bind="sr.ActualResult" @bind:after="SaveChangesAsync" />
                                            </div>
                                        }
                                        else
                                        {
                                            @sr.ActualResult
                                        }
                                    </td>
                                    <td>
                                        @if (canEdit && testRun.Status != "Completed")
                                        {
                                            <select class="form-select form-select-sm @(sr.Status == "Pass" ? "text-success fw-bold" : sr.Status == "Fail" ? "text-danger fw-bold" : "")" 
                                                    @bind="sr.Status" @bind:after="SaveChangesAsync">
                                                <option value="Not Run">Not Run</option>
                                                <option value="Pass">Pass</option>
                                                <option value="Fail">Fail</option>
                                            </select>
                                        }
                                        else
                                        {
                                            @if (sr.Status == "Pass") { <span class="text-success fw-bold">✔ PASS</span> }
                                            else if (sr.Status == "Fail") { <span class="text-danger fw-bold">✘ FAIL</span> }
                                            else { <span class="text-muted">@sr.Status</span> }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private TestRun? testRun;
    private bool canEdit = false;
    private HashSet<int> collapsedCases = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            if (user.Role == "Administrator" || user.Role == "Editor")
            {
                canEdit = true;
            }
        }

        testRun = await DbContext.TestRuns
            .Include(r => r.Project)
            .Include(r => r.TestSuite)
            .Include(r => r.User)
            .Include(r => r.CaseResults)
                .ThenInclude(cr => cr.TestCase)
            .Include(r => r.CaseResults)
                .ThenInclude(cr => cr.StepResults)
                    .ThenInclude(sr => sr.TestStep)
            .FirstOrDefaultAsync(r => r.Id == Id);

        if (testRun == null)
        {
            NavigationManager.NavigateTo("/testruns");
        }
    }

    private void ToggleCaseCollapse(int caseResultId)
    {
        if (collapsedCases.Contains(caseResultId)) collapsedCases.Remove(caseResultId);
        else collapsedCases.Add(caseResultId);
    }

    private async Task SaveChangesAsync()
    {
        if (canEdit)
        {
            await DbContext.SaveChangesAsync();
        }
    }
}
