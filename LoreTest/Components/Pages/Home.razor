@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>@L["Home"] - Dashboard</PageTitle>

<div class="headline-md mb-2">@L["WelcomeTitle"]</div>
<div class="body-md text-muted mb-4">@DateTime.Today.ToLongDateString()</div>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]</span>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <!-- Stats Cards -->
        <div class="col-md-3">
            <div class="card h-100 border-0" style="background-color: var(--primary); color: white;">
                <div class="card-body">
                    <div class="label-caps mb-2 opacity-75">@L["MyActiveTasks"]</div>
                    <div class="display-lg">@myActiveRuns.Count</div>
                    <div class="body-sm mt-2 opacity-75">@L["RunsInProgress"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0" style="background-color: var(--secondary); color: white;">
                <div class="card-body">
                    <div class="label-caps mb-2 opacity-75">@L["LastWeekRuns"]</div>
                    <div class="display-lg">@lastWeekRunsCount</div>
                    <div class="body-sm mt-2 opacity-75">@L["CompletedIn7Days"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0" style="background-color: var(--success); color: white;">
                <div class="card-body">
                    <div class="label-caps mb-2 opacity-75">@L["WeeklyPasses"]</div>
                    <div class="display-lg">@weeklyPassCount</div>
                    <div class="body-sm mt-2 opacity-75">@L["TestCasesPassed"]</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-0" style="background-color: var(--error); color: white;">
                <div class="card-body">
                    <div class="label-caps mb-2 opacity-75">@L["WeeklyFailures"]</div>
                    <div class="display-lg">@weeklyFailCount</div>
                    <div class="body-sm mt-2 opacity-75">@L["TestCasesFailed"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Active Tasks -->
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header py-3 d-flex align-items-center">
                    <span class="material-symbols-outlined me-2">list_alt</span>
                    <span class="title-sm mb-0">@L["MyActiveTasks"]</span>
                </div>
                <div class="card-body p-0">
                    @if (!myActiveRuns.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            <span class="material-symbols-outlined display-lg d-block mb-2 opacity-25">check_circle</span>
                            <div class="body-md">@L["NoActiveTasks"]</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>@L["Project"]</th>
                                        <th>@L["Suite"]</th>
                                        <th>@L["Progress"]</th>
                                        <th class="text-end">@L["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var run in myActiveRuns)
                                    {
                                        <tr>
                                            <td class="data-mono fw-bold">@run.RunNumber</td>
                                            <td class="body-md">@run.Project?.Title</td>
                                            <td class="body-md">@run.TestSuite?.Title</td>
                                            <td style="min-width: 140px;">
                                                @{
                                                    var total = run.CaseResults.Count;
                                                    var completed = run.CaseResults.Count(cr => cr.Status != "Pending");
                                                    var percent = total > 0 ? (int)((double)completed / total * 100) : 0;
                                                }
                                                <div class="progress mb-1" style="height: 4px; background-color: var(--surface-container-high);">
                                                    <div class="progress-bar" style="width: @percent%; background-color: var(--success);"></div>
                                                </div>
                                                <div class="label-caps text-muted">@percent% (@completed/@total)</div>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a href="/testruns/execute/@run.Id" class="btn btn-sm btn-outline-primary">@L["Resume"]</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Recent Activity / Shortcuts -->
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header py-3 d-flex align-items-center">
                    <span class="material-symbols-outlined me-2">bolt</span>
                    <span class="title-sm mb-0">@L["QuickLinks"]</span>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/testruns/create" class="btn btn-outline-primary text-start d-flex align-items-center p-3">
                            <span class="material-symbols-outlined me-3">play_circle</span>
                            <span class="body-md flex-grow-1">@L["StartNewRun"]</span>
                            <span class="material-symbols-outlined small opacity-50">chevron_right</span>
                        </a>
                        <a href="/bugs/create" class="btn btn-outline-primary text-start d-flex align-items-center p-3">
                            <span class="material-symbols-outlined me-3">bug_report</span>
                            <span class="body-md flex-grow-1">@L["ReportBug"]</span>
                            <span class="material-symbols-outlined small opacity-50">chevron_right</span>
                        </a>
                        <a href="/projects" class="btn btn-outline-primary text-start d-flex align-items-center p-3">
                            <span class="material-symbols-outlined me-3">folder</span>
                            <span class="body-md flex-grow-1">@L["BrowseProjects"]</span>
                            <span class="material-symbols-outlined small opacity-50">chevron_right</span>
                        </a>
                    </div>

                    <div class="mt-4 pt-4 border-top">
                        <div class="label-caps mb-3">@L["SystemSummary"]</div>
                        <div class="card bg-light border-0">
                            <div class="card-body py-2 px-3 body-sm d-flex align-items-center">
                                <span class="material-symbols-outlined small me-2 text-primary">info</span>
                                <span>@string.Format(L["SystemStatsMessage"], weeklyPassCount + weeklyFailCount, lastWeekRunsCount)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<TestRun> myActiveRuns = new();
    private int lastWeekRunsCount = 0;
    private int weeklyPassCount = 0;
    private int weeklyFailCount = 0;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        
        if (user != null)
        {
            myActiveRuns = await DbContext.TestRuns
                .Include(r => r.Project)
                .Include(r => r.TestSuite)
                .Include(r => r.CaseResults)
                .Where(r => r.StartedByUserId == user.Id && r.Status == "In Progress")
                .OrderByDescending(r => r.StartTime)
                .ToListAsync();
        }

        var lastWeek = DateTime.UtcNow.AddDays(-7);
        
        lastWeekRunsCount = await DbContext.TestRuns
            .Where(r => r.StartTime >= lastWeek && r.Status == "Completed")
            .CountAsync();

        var weeklyCaseResults = await DbContext.TestRunCaseResults
            .Include(cr => cr.TestRun)
            .Where(cr => cr.TestRun!.StartTime >= lastWeek && cr.Status != "Pending")
            .ToListAsync();

        weeklyPassCount = weeklyCaseResults.Count(cr => cr.Status == "Pass");
        weeklyFailCount = weeklyCaseResults.Count(cr => cr.Status == "Fail");

        isLoading = false;
    }
}

