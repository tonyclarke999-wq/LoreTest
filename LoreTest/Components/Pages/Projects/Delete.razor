@page "/projects/delete/{id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@attribute [Authorize]

<PageTitle>Delete Test Project</PageTitle>

<h1>Delete Test Project</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    @if (project == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Reference No.</dt>
            <dd class="col-sm-10">@project.Id</dd>

            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@project.Title</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@((MarkupString)(project.Description ?? ""))</dd>
        </dl>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="project" OnValidSubmit="DeleteProject" FormName="DeleteProjectForm">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="/projects" class="btn btn-secondary">Back to List</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private TestProject? project;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null || (user.Role != "Administrator" && user.Role != "Tester"))
        {
            NavigationManager.NavigateTo("/projects");
            return;
        }

        project = await DbContext.TestProjects.FirstOrDefaultAsync(m => m.Id == Id);

        if (project == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private async Task DeleteProject()
    {
        if (project == null) return;
        
        try
        {
            DbContext.TestProjects.Remove(project);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo("/projects");
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while deleting the project: {ex.Message}";
        }
    }
}
