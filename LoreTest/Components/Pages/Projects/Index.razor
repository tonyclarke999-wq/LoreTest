@page "/projects"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["TestProjects"]</PageTitle>

<h1>@L["TestProjects"]</h1>

@if (canEdit)
{
    <p>
        <a href="/projects/create" class="btn btn-primary">@L["CreateNew"]</a>
    </p>
}

@if (projects == null)
{
    <p><em>@L["Loading"]</em></p>
}
else if (!projects.Any())
{
    <p>@L["NoProjectsFound"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["ReferenceNo"]</th>
                <th>@L["Title"]</th>
                <th>@L["Description"]</th>
                <th>@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in projects)
            {
                <tr>
                    <td>@project.Id</td>
                    <td>@project.Title</td>
                    <td>@((MarkupString)(project.Description ?? ""))</td>
                    <td>
                        <a href="/projects/details/@project.Id">@L["Details"]</a>
                        @if (canEdit)
                        {
                            <span> | </span>
                            <a href="/projects/edit/@project.Id">@L["Edit"]</a> <span> | </span>
                            <a href="/projects/delete/@project.Id">@L["Delete"]</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TestProject>? projects;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        
        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        projects = await DbContext.TestProjects.OrderBy(p => p.Id).ToListAsync();
    }
}
