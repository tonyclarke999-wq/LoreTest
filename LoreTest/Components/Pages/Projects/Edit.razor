@page "/projects/edit/{id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> L
@inject LoreTest.Utilities.JiraIntegrationService JiraService
@attribute [Authorize]

<PageTitle>@L["EditTestProject"]</PageTitle>

<h1>@L["EditTestProject"]</h1>
<hr />

@if (Input == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Input" OnValidSubmit="ValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label for="title" class="form-label">@L["Title"]</label>
                    <InputText id="title" @bind-Value="Input.Title" class="form-control" />
                    <ValidationMessage For="() => Input.Title" class="text-danger" />
                </div>
                
                <div class="mb-3">
                    <label for="jiraReference" class="form-label">Jira Reference (e.g. PROJ-123)</label>
                    <div class="input-group">
                        <InputText id="jiraReference" @bind-Value="Input.JiraReference" class="form-control" placeholder="PROJ-123" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="FetchJiraDetails" disabled="@isFetchingJira">
                            @if (isFetchingJira) {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            } else {
                                <span>Fetch from Jira</span>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="() => Input.JiraReference" class="text-danger" />
                </div>
                <div class="mb-3" style="margin-bottom: 60px !important;">
                    <label for="description" class="form-label">@L["Description"]</label>
                    <div @ref="editorElement" style="height: 200px;"></div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a href="/projects" class="btn btn-secondary">@L["BackToList"]</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TestProject? Input { get; set; }

    private ElementReference editorElement;
    private string? errorMessage;
    private bool isFetchingJira = false;

    private async Task FetchJiraDetails()
    {
        if (string.IsNullOrWhiteSpace(Input?.JiraReference))
        {
            errorMessage = "Please enter a Jira Reference.";
            return;
        }

        isFetchingJira = true;
        errorMessage = null;

        try
        {
            var settings = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(DbContext.AppSettings);

            if (settings == null || string.IsNullOrWhiteSpace(settings.JiraApiToken) || string.IsNullOrWhiteSpace(settings.JiraBaseUrl))
            {
                errorMessage = "Jira API Token and Base URL are not configured in Admin Settings. The reference will just be saved.";
                isFetchingJira = false;
                return;
            }

            var result = await JiraService.FetchIssueDetailsAsync(Input.JiraReference, settings);
            if (result.HasValue)
            {
                Input.Title = result.Value.Title;
                Input.Description = result.Value.Description;
                
                await JSRuntime.InvokeVoidAsync("initQuill", editorElement, Input.Description);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isFetchingJira = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null || (user.Role != "Administrator" && user.Role != "Editor"))
        {
            NavigationManager.NavigateTo("/projects");
            return;
        }

        Input = await DbContext.TestProjects.FirstOrDefaultAsync(m => m.Id == Id);

        if (Input == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Input != null)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (!window.quillInitialized) {
                    window.initQuill = function(element, initialContent) {
                        var quill = new Quill(element, { 
                            theme: 'snow',
                            modules: {
                                toolbar: [
                                    [{ 'header': [1, 2, 3, false] }],
                                    ['bold', 'italic', 'underline', 'strike'],
                                    ['image', 'link', 'blockquote', 'code-block'],
                                    [{ 'list': 'ordered'}, { 'list': 'bullet' }]
                                ]
                            }
                        });
                        quill.root.innerHTML = initialContent || '';
                        element.quill = quill;
                    };
                    window.getQuillContent = function(element) {
                        return element.quill ? element.quill.root.innerHTML : '';
                    };
                    window.quillInitialized = true;
                }
            ");
            await JSRuntime.InvokeVoidAsync("initQuill", editorElement, Input.Description ?? "");
        }
    }

    private async Task ValidSubmit()
    {
        if (Input == null) return;
        
        Input.Description = await JSRuntime.InvokeAsync<string>("getQuillContent", editorElement);
        
        errorMessage = null;

        try
        {
            DbContext.Attach(Input).State = EntityState.Modified;
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo("/projects");
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ProjectExists(Input.Id))
            {
                NavigationManager.NavigateTo("/projects");
            }
            else
            {
                errorMessage = "A concurrency error occurred while updating the project.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while updating the project: {ex.Message}";
        }
    }

    private bool ProjectExists(int id)
    {
        return DbContext.TestProjects.Any(e => e.Id == id);
    }
}
