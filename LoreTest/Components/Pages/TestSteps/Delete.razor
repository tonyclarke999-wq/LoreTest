@page "/teststeps/delete/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Delete Test Step</PageTitle>

@if (!canEdit)
{
    <div class="alert alert-danger">You do not have permission to delete test steps.</div>
}
else if (step == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/testsuites/details/@step.TestCase?.TestSuiteId">Test Suite</a></li>
            <li class="breadcrumb-item"><a href="/testcases/details/@step.TestCaseId?tab=steps">@step.TestCase?.Title</a></li>
            <li class="breadcrumb-item active">Delete Step @step.StepNumber</li>
        </ol>
    </nav>

    <h1>Delete Test Step</h1>

    <div class="alert alert-danger mt-3">
        <strong>Are you sure you want to permanently delete this step?</strong>
        <br />This action cannot be undone.
    </div>

    <div class="card mt-3" style="max-width: 700px;">
        <div class="card-header">
            <strong>Step @step.StepNumber</strong>
            &mdash;
            <span class="text-muted">@step.TestCase?.Title</span>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(step.Description))
            {
                <p><strong>Description:</strong></p>
                <div class="border rounded p-2 bg-light mb-3">
                    @((MarkupString)(step.Description))
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(step.ExpectedResult))
            {
                <p><strong>Expected Result:</strong></p>
                <div class="border rounded p-2 bg-light mb-3">
                    @((MarkupString)(step.ExpectedResult))
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(step.ActualResult))
            {
                <p><strong>Actual Result:</strong></p>
                <div class="border rounded p-2 bg-light">
                    @((MarkupString)(step.ActualResult))
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-danger" @onclick="ConfirmDelete">Yes, Delete Step</button>
        <a href="/testcases/details/@step.TestCaseId?tab=steps" class="btn btn-secondary">Cancel</a>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TestStep? step;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        step = await DbContext.TestSteps
            .Include(s => s.TestCase)
                .ThenInclude(tc => tc!.TestSuite)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (step == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private async Task ConfirmDelete()
    {
        if (!canEdit || step == null) return;

        var testCaseId = step.TestCaseId;
        DbContext.TestSteps.Remove(step);
        await DbContext.SaveChangesAsync();

        NavigationManager.NavigateTo($"/testcases/details/{testCaseId}?tab=steps");
    }
}
