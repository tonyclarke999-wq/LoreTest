@page "/teststeps/create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["AddTestStep"]</PageTitle>

@if (!canEdit)
{
    <div class="alert alert-danger">@L["NoPermissionAddTestStep"]</div>
}
else if (testCase == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/testsuites/details/@testCase.TestSuiteId">@L["TestSuite"]</a></li>
            <li class="breadcrumb-item"><a href="/testcases/details/@testCase.Id?tab=steps">@testCase.Title</a></li>
            <li class="breadcrumb-item active">@L["AddStepPrefix"] @nextStepNumber</li>
        </ol>
    </nav>

    <h1>@L["AddTestStep"]</h1>
    <p class="text-muted">@L["StepPrefix"] <strong>@nextStepNumber</strong> &mdash; @testCase.Title</p>

    <hr />
    <div class="row">
        <div class="col-md-10 col-lg-8">

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["StepNumber"]</label>
                <input type="number" class="form-control" style="max-width: 120px;"
                       @bind="newStep.StepNumber" min="1" />
                <div class="form-text">@L["StepNumberHelp"]</div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@L["StepDescription"] <span class="text-danger">*</span></label>
                    <div @ref="editorDescription" style="height: 180px;"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@L["ExpectedResult"]</label>
                    <div @ref="editorExpectedResult" style="height: 180px;"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@L["ActualResult"] <span class="text-muted small">@L["IfDifferent"]</span></label>
                    <div @ref="editorActualResult" style="height: 180px;"></div>
                </div>
            </div>

            <div class="d-flex gap-2" style="margin-top: 55px;">
                <button class="btn btn-primary" @onclick="SaveStep">@L["SaveStep"]</button>
                <a href="/testcases/details/@testCase.Id?tab=steps" class="btn btn-secondary">@L["Cancel"]</a>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "testCaseId")]
    public int TestCaseId { get; set; }

    private TestCase? testCase;
    private TestStep newStep = new();
    private int nextStepNumber = 1;
    private bool canEdit = false;
    private string? errorMessage;

    private ElementReference editorDescription;
    private ElementReference editorExpectedResult;
    private ElementReference editorActualResult;
    private bool quillReady = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        if (canEdit)
        {
            testCase = await DbContext.TestCases
                .Include(tc => tc.TestSteps)
                .FirstOrDefaultAsync(m => m.Id == TestCaseId);

            if (testCase == null)
            {
                NavigationManager.NavigateTo("/projects");
                return;
            }

            nextStepNumber = testCase.TestSteps.Any()
                ? testCase.TestSteps.Max(s => s.StepNumber) + 1
                : 1;

            newStep = new TestStep
            {
                TestCaseId = TestCaseId,
                StepNumber = nextStepNumber
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (canEdit && testCase != null && !quillReady)
        {
            quillReady = true;
            await InitQuill();
        }
    }

    private async Task InitQuill()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            if (!window.quillInitialized) {
                window.initQuill = function(element, initialContent) {
                    var quill = new Quill(element, {
                        theme: 'snow',
                        modules: {
                            toolbar: [
                                [{ 'header': [1, 2, 3, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                                ['link', 'blockquote', 'code-block']
                            ]
                        }
                    });
                    quill.root.innerHTML = initialContent || '';
                    element.quill = quill;
                };
                window.getQuillContent = function(element) {
                    return element.quill ? element.quill.root.innerHTML : '';
                };
                window.quillInitialized = true;
            }
        ");
        await JSRuntime.InvokeVoidAsync("initQuill", editorDescription, "");
        await JSRuntime.InvokeVoidAsync("initQuill", editorExpectedResult, "");
        await JSRuntime.InvokeVoidAsync("initQuill", editorActualResult, "");
    }

    private async Task SaveStep()
    {
        if (!canEdit || testCase == null) return;

        newStep.Description = await JSRuntime.InvokeAsync<string>("getQuillContent", editorDescription);
        newStep.ExpectedResult = await JSRuntime.InvokeAsync<string>("getQuillContent", editorExpectedResult);
        newStep.ActualResult = await JSRuntime.InvokeAsync<string>("getQuillContent", editorActualResult);
        newStep.TestCaseId = TestCaseId;

        DbContext.TestSteps.Add(newStep);
        await DbContext.SaveChangesAsync();

        NavigationManager.NavigateTo($"/testcases/details/{TestCaseId}?tab=steps");
    }
}
