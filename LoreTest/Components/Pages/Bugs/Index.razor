@page "/bugs"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L
@inject ITranslationService TranslationService
@attribute [Authorize]

<PageTitle>@L["BugReports"]</PageTitle>

<h1>@L["BugReports"]</h1>

<p>
    <a href="/bugs/create" class="btn btn-primary">@L["ReportNewBug"]</a>
</p>

@if (bugs == null)
{
    <p><em>@L["Loading"]</em></p>
}
else if (!bugs.Any())
{
    <p>@L["NoBugsFound"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["ID"]</th>
                <th>@L["Title"]</th>
                <th>@L["Severity"]</th>
                <th>@L["Priority"]</th>
                <th>@L["Status"]</th>
                <th>@L["Reporter"]</th>
                <th>Project</th>
                <th>@L["Assignee"]</th>
                <th>@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bug in bugs)
            {
                <tr>
                    <td>@bug.Id</td>
                    <td>@translatedTitles.GetValueOrDefault(bug.Id, bug.Title)</td>
                    <td>
                        <span class="badge @GetSeverityClass(bug.Severity)">@L[bug.Severity.ToString()]</span>
                    </td>
                    <td>
                        <span class="badge @GetPriorityClass(bug.Priority)">@L[bug.Priority.ToString()]</span>
                    </td>
                    <td>
                        <span class="badge @GetStatusClass(bug.Status)">@L[bug.Status.ToString()]</span>
                    </td>
                    <td>@(bug.Reporter?.UserName ?? L["Unknown"])</td>
                    <td>@(bug.Project?.Title ?? "None")</td>
                    <td>@(bug.Assignee?.UserName ?? L["Unassigned"])</td>
                    <td>
                        <a href="/bugs/details/@bug.Id">@L["Details"]</a> |
                        <a href="/bugs/edit/@bug.Id">@L["Edit"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Bug>? bugs;
    private Dictionary<int, string> translatedTitles = new();

    protected override async Task OnInitializedAsync()
    {
        bugs = await DbContext.Bugs
            .Include(b => b.Reporter)
            .Include(b => b.Assignee)
            .Include(b => b.Project)
            .OrderByDescending(b => b.ReportedDate)
            .ToListAsync();

        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        foreach (var bug in bugs)
        {
            translatedTitles[bug.Id] = await TranslationService.TranslateAsync(bug.Title, bug.OriginalCulture ?? "en", currentCulture);
        }
    }

    private string GetSeverityClass(BugSeverity severity) => severity switch
    {
        BugSeverity.Critical => "bg-danger",
        BugSeverity.Major => "bg-warning text-dark",
        BugSeverity.Minor => "bg-info text-dark",
        BugSeverity.Cosmetic => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private string GetPriorityClass(BugPriority priority) => priority switch
    {
        BugPriority.High => "text-danger",
        BugPriority.Medium => "text-warning",
        BugPriority.Low => "text-success",
        _ => ""
    };

    private string GetStatusClass(BugStatus status) => status switch
    {
        BugStatus.Open => "bg-primary",
        BugStatus.InProgress => "bg-warning text-dark",
        BugStatus.Resolved => "bg-success",
        BugStatus.Closed => "bg-secondary",
        BugStatus.Reopened => "bg-info text-dark",
        _ => "bg-light text-dark"
    };
}
