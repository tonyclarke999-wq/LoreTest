@page "/bugs/create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@using System.IO
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject IStringLocalizer<SharedResource> L
@inject LoreTest.Utilities.JiraIntegrationService JiraService
@attribute [Authorize]

<PageTitle>@L["ReportBug"]</PageTitle>

<h1>@L["ReportNewBug"]</h1>

<hr />

<div class="row">
    <div class="col-md-8">
        <EditForm Model="bug" OnValidSubmit="HandleValidSubmit" FormName="CreateBugForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="project" class="form-label">Project</label>
                <InputSelect id="project" @bind-Value="bug.ProjectId" class="form-select">
                    <option value="">-- No Project --</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Title</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label for="title" class="form-label">@L["Title"]</label>
                <InputText id="title" @bind-Value="bug.Title" class="form-control" placeholder="@L["TitlePlaceholder"]" />
                <ValidationMessage For="() => bug.Title" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">@L["DescriptionReproductionSteps"]</label>
                <InputTextArea id="description" @bind-Value="bug.Description" class="form-control" rows="5" placeholder="@L["DescriptionPlaceholder"]" />
                <ValidationMessage For="() => bug.Description" class="text-danger" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="expected" class="form-label">@L["ExpectedResult"]</label>
                    <InputTextArea id="expected" @bind-Value="bug.ExpectedResult" class="form-control" rows="3" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="actual" class="form-label">@L["ActualResult"]</label>
                    <InputTextArea id="actual" @bind-Value="bug.ActualResult" class="form-control" rows="3" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="severity" class="form-label">@L["Severity"]</label>
                    <InputSelect id="severity" @bind-Value="bug.Severity" class="form-select">
                        @foreach (var val in Enum.GetValues<BugSeverity>())
                        {
                            <option value="@val">@L[val.ToString()]</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="priority" class="form-label">@L["Priority"]</label>
                    <InputSelect id="priority" @bind-Value="bug.Priority" class="form-select">
                        @foreach (var val in Enum.GetValues<BugPriority>())
                        {
                            <option value="@val">@L[val.ToString()]</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="environment" class="form-label">@L["Environment"]</label>
                    <InputText id="environment" @bind-Value="bug.Environment" class="form-control" placeholder="@L["EnvironmentPlaceholder"]" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="components" class="form-label">@L["Components"]</label>
                    <InputText id="components" @bind-Value="bug.Components" class="form-control" placeholder="@L["ComponentsPlaceholder"]" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="labels" class="form-label">@L["Labels"]</label>
                    <InputText id="labels" @bind-Value="bug.Labels" class="form-control" placeholder="@L["LabelsPlaceholder"]" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="assignee" class="form-label">@L["Assignee"]</label>
                    <InputSelect id="assignee" @bind-Value="bug.AssigneeId" class="form-select">
                        <option value="">-- @L["Unassigned"] --</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.UserName</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="dueDate" class="form-label">@L["DueDate"]</label>
                    <InputDate id="dueDate" @bind-Value="bug.DueDate" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="affectedVersion" class="form-label">@L["AffectedVersion"]</label>
                    <InputText id="affectedVersion" @bind-Value="bug.AffectedVersion" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="fixVersion" class="form-label">@L["FixVersion"]</label>
                    <InputText id="fixVersion" @bind-Value="bug.FixVersion" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label for="attachments" class="form-label">@L["AttachmentsLabel"]</label>
                <InputFile OnChange="LoadFiles" class="form-control" multiple />
                @if (selectedFiles.Any())
                {
                    <ul class="mt-2 list-unstyled">
                        @foreach (var file in selectedFiles)
                        {
                            <li><i class="bi bi-file-earmark"></i> @file.Name (@(file.Size / 1024) KB)</li>
                        }
                    </ul>
                }
            </div>

            <div class="mt-4 mb-5">
                @if (!isCreated)
                {
                    <button type="submit" class="btn btn-success me-2">@L["CreateBugReport"]</button>
                    <a href="/bugs" class="btn btn-secondary">@L["Cancel"]</a>
                }
                else
                {
                    <div class="alert alert-success">Bug created successfully!</div>
                    @if (canCreateJiraBug)
                    {
                        <button type="button" class="btn btn-primary me-2" @onclick="CreateJiraBug" disabled="@isCreatingJiraBug">
                            @if (isCreatingJiraBug)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Create JIRA Bug
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(jiraBugError))
                    {
                        <div class="alert alert-danger mt-2">@jiraBugError</div>
                    }
                    @if (!string.IsNullOrEmpty(bug.JiraBugReference))
                    {
                        <div class="alert alert-info mt-2">
                            Jira Ticket Created: 
                            <a href="@($"{jiraBaseUrl?.TrimEnd('/')}/browse/{bug.JiraBugReference}")" target="_blank">
                                @bug.JiraBugReference
                            </a>
                        </div>
                    }
                    <a href="/bugs" class="btn btn-secondary mt-2">Back to Bugs</a>
                }
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Bug bug = new();
    private List<ApplicationUser> users = new();
    private List<TestProject> projects = new();
    private List<IBrowserFile> selectedFiles = new();
    private long maxFileSize = 1024 * 1024 * 10; // 10MB
    
    private bool isCreated = false;
    private bool canCreateJiraBug = false;
    private bool isCreatingJiraBug = false;
    private string? jiraBugError;
    private string? jiraBaseUrl;

    protected override async Task OnInitializedAsync()
    {
        bug.OriginalCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        users = await UserManager.Users.OrderBy(u => u.UserName).ToListAsync();
        projects = await DbContext.TestProjects.OrderBy(p => p.Title).ToListAsync();
        
        var settings = await DbContext.AppSettings.FirstOrDefaultAsync();
        jiraBaseUrl = settings?.JiraBaseUrl;
        
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            bug.ReporterId = user.Id;
        }
    }

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        selectedFiles.Clear();
        foreach (var file in e.GetMultipleFiles())
        {
            selectedFiles.Add(file);
        }
    }

    private async Task HandleValidSubmit()
    {
        DbContext.Bugs.Add(bug);
        await DbContext.SaveChangesAsync();

        if (selectedFiles.Any())
        {
            var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads", "bugs", bug.Id.ToString());
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }

            foreach (var file in selectedFiles)
            {
                var fileName = file.Name;
                var filePath = Path.Combine("uploads", "bugs", bug.Id.ToString(), fileName);
                var fullPath = Path.Combine(Environment.WebRootPath, filePath);

                await using FileStream fs = new(fullPath, FileMode.Create);
                await file.OpenReadStream(maxFileSize).CopyToAsync(fs);

                bug.Attachments.Add(new BugAttachment
                {
                    BugId = bug.Id,
                    FileName = fileName,
                    FilePath = filePath,
                    ContentType = file.ContentType,
                    FileSize = file.Size
                });
            }

            await DbContext.SaveChangesAsync();
        }

        isCreated = true;

        if (bug.ProjectId.HasValue)
        {
            var project = await DbContext.TestProjects.FindAsync(bug.ProjectId.Value);
            var settings = await DbContext.AppSettings.FirstOrDefaultAsync();
            if (project != null && !string.IsNullOrWhiteSpace(project.JiraReference) && 
                settings != null && !string.IsNullOrWhiteSpace(settings.JiraApiToken) && 
                !string.IsNullOrWhiteSpace(settings.JiraBaseUrl))
            {
                canCreateJiraBug = true;
                bug.Project = project; // For the Jira create method
            }
        }
    }

    private async Task CreateJiraBug()
    {
        isCreatingJiraBug = true;
        jiraBugError = null;
        try
        {
            var settings = await DbContext.AppSettings.FirstOrDefaultAsync();
            if (settings == null || bug.Project == null) return;

            string newJiraKey = await JiraService.CreateBugAsync(bug, bug.Project.JiraReference!, settings);
            bug.JiraBugReference = newJiraKey;
            
            // Save to database
            DbContext.Bugs.Update(bug);
            await DbContext.SaveChangesAsync();
            
            canCreateJiraBug = false; // Hide button once created
        }
        catch (Exception ex)
        {
            jiraBugError = ex.Message;
        }
        finally
        {
            isCreatingJiraBug = false;
        }
    }
}
