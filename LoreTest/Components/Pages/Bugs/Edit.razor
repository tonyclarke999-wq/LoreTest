@page "/bugs/edit/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Edit Bug #@Id</PageTitle>

<h1>Edit Bug #@Id</h1>

@if (bug == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <EditForm Model="bug" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <InputText id="title" @bind-Value="bug.Title" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description / Repro Steps</label>
                    <InputTextArea id="description" @bind-Value="bug.Description" class="form-control" rows="5" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="status" class="form-label text-primary fw-bold">Status</label>
                        <InputSelect id="status" @bind-Value="bug.Status" class="form-select border-primary">
                            @foreach (var val in Enum.GetValues<BugStatus>()) { <option value="@val">@val</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="severity" class="form-label">Severity</label>
                        <InputSelect id="severity" @bind-Value="bug.Severity" class="form-select">
                            @foreach (var val in Enum.GetValues<BugSeverity>()) { <option value="@val">@val</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="priority" class="form-label">Priority</label>
                        <InputSelect id="priority" @bind-Value="bug.Priority" class="form-select">
                            @foreach (var val in Enum.GetValues<BugPriority>()) { <option value="@val">@val</option> }
                        </InputSelect>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="resolution" class="form-label fw-bold">Resolution Notes</label>
                    <InputTextArea id="resolution" @bind-Value="bug.Resolution" class="form-control" rows="3" placeholder="How was this fixed?" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="assignee" class="form-label">Assignee</label>
                        <InputSelect id="assignee" @bind-Value="bug.AssigneeId" class="form-select">
                            <option value="">-- Unassigned --</option>
                            @foreach (var user in users) { <option value="@user.Id">@user.UserName</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="fixVersion" class="form-label">Fix Version</label>
                        <InputText id="fixVersion" @bind-Value="bug.FixVersion" class="form-control" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2">Save Changes</button>
                    <a href="/bugs/details/@Id" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Bug? bug;
    private List<ApplicationUser> users = new();

    protected override async Task OnInitializedAsync()
    {
        bug = await DbContext.Bugs.FindAsync(Id);
        users = await UserManager.Users.OrderBy(u => u.UserName).ToListAsync();
    }

    private async Task HandleValidSubmit()
    {
        await DbContext.SaveChangesAsync();
        NavigationManager.NavigateTo($"/bugs/details/{Id}");
    }
}
