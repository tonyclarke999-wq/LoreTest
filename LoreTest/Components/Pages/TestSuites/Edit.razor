@page "/testsuites/edit/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["EditSuite"]</PageTitle>

<h1>@L["EditSuite"]</h1>

@if (!canEdit)
{
    <p>@L["NoPermissionEditTestSuite"]</p>
}
else if (testSuite == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <hr />
    <div class="row">
        <div class="col-md-8">
            <EditForm Model="testSuite" OnValidSubmit="UpdateTestSuite">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label for="title" class="form-label">@L["Title"]:</label>
                    <InputText id="title" @bind-Value="testSuite.Title" class="form-control" />
                    <ValidationMessage For="() => testSuite.Title" class="text-danger" />
                </div>

                <div class="mb-3" style="margin-bottom: 60px !important;">
                    <label for="description" class="form-label">@L["Description"]:</label>
                    <div @ref="editorDescription" style="height: 200px;"></div>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 60px;">@L["Save"]</button>
            </EditForm>
        </div>
    </div>
}

<div class="mt-3">
    <a href="/testsuites/details/@Id">@L["BackToTestSuite"]</a>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private TestSuite? testSuite;
    private bool canEdit = false;
    private ElementReference editorDescription;
    private bool quillReady = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        testSuite = await DbContext.TestSuites.FirstOrDefaultAsync(m => m.Id == Id);

        if (testSuite == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (canEdit && testSuite != null && !quillReady)
        {
            quillReady = true;
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (!window.quillInitialized) {
                    window.initQuill = function(element, initialContent) {
                        var quill = new Quill(element, { 
                            theme: 'snow',
                            modules: {
                                toolbar: [
                                    [{ 'header': [1, 2, 3, false] }],
                                    ['bold', 'italic', 'underline', 'strike'],
                                    ['image', 'link', 'blockquote', 'code-block'],
                                    [{ 'list': 'ordered'}, { 'list': 'bullet' }]
                                ]
                            }
                        });
                        quill.root.innerHTML = initialContent || '';
                        element.quill = quill;
                    };
                    window.getQuillContent = function(element) {
                        return element.quill ? element.quill.root.innerHTML : '';
                    };
                    window.quillInitialized = true;
                }
            ");
            await JSRuntime.InvokeVoidAsync("initQuill", editorDescription, testSuite.Description ?? "");
        }
    }

    private async Task UpdateTestSuite()
    {
        if (canEdit && testSuite != null)
        {
            testSuite.Description = await JSRuntime.InvokeAsync<string>("getQuillContent", editorDescription);

            DbContext.TestSuites.Update(testSuite);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo($"/testsuites/details/{testSuite.Id}");
        }
    }
}
