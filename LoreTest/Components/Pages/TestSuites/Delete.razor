@page "/testsuites/delete/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["DeleteTestSuite"]</PageTitle>

<h1>@L["DeleteTestSuite"]</h1>

@if (!canEdit)
{
    <p>@L["NoPermissionDeleteTestSuite"]</p>
}
else if (testSuite == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <div class="alert alert-danger">
        <strong>@L["DeleteTestSuiteConfirmation"]</strong>
        <br />@L["DeleteTestSuiteWarning"]
    </div>

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@testSuite.Id</dd>
        <dt class="col-sm-3">@L["Title"]</dt>
        <dd class="col-sm-9">@testSuite.Title</dd>
        <dt class="col-sm-3">@L["TestCases"]</dt>
        <dd class="col-sm-9">@testSuite.TestCases.Count</dd>
    </dl>

    <button class="btn btn-danger" @onclick="DeleteTestSuite">@L["Delete"]</button>
    <a href="/testsuites/details/@testSuite.Id" class="btn btn-secondary ms-2">@L["Cancel"]</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TestSuite? testSuite;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        testSuite = await DbContext.TestSuites
            .Include(s => s.TestCases)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (testSuite == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private async Task DeleteTestSuite()
    {
        if (canEdit && testSuite != null)
        {
            var projectId = testSuite.TestProjectId;
            DbContext.TestSuites.Remove(testSuite);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo($"/projects/details/{projectId}");
        }
    }
}
