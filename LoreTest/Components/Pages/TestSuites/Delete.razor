@page "/testsuites/delete/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Delete Test Suite</PageTitle>

<h1>Delete Test Suite</h1>

@if (!canEdit)
{
    <p>You do not have permission to delete test suites.</p>
}
else if (testSuite == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this test suite?</strong>
        <br />This will also delete all test cases and steps associated with it.
    </div>

    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@testSuite.Id</dd>
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@testSuite.Title</dd>
        <dt class="col-sm-3">Test Cases</dt>
        <dd class="col-sm-9">@testSuite.TestCases.Count</dd>
    </dl>

    <button class="btn btn-danger" @onclick="DeleteTestSuite">Delete</button>
    <a href="/testsuites/details/@testSuite.Id" class="btn btn-secondary ms-2">Cancel</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TestSuite? testSuite;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        testSuite = await DbContext.TestSuites
            .Include(s => s.TestCases)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (testSuite == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private async Task DeleteTestSuite()
    {
        if (canEdit && testSuite != null)
        {
            var projectId = testSuite.TestProjectId;
            DbContext.TestSuites.Remove(testSuite);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo($"/projects/details/{projectId}");
        }
    }
}
