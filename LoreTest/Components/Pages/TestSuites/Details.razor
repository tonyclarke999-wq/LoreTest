@page "/testsuites/details/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["TestSuiteDetails"]</PageTitle>

@if (testSuite == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center">
        <h1>@L["TestSuiteTitlePrefix"] @testSuite.Title</h1>
        @if (canEdit)
        {
            <div>
                <a href="/testsuites/edit/@testSuite.Id" class="btn btn-outline-primary btn-sm">@L["EditSuite"]</a>
                <a href="/testsuites/delete/@testSuite.Id" class="btn btn-outline-danger btn-sm ms-1">@L["DeleteSuite"]</a>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(testSuite.Description))
    {
        <div class="mb-3 mt-2">@((MarkupString)(testSuite.Description))</div>
    }

    <hr />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@L["TestCases"]</h2>
        @if (canEdit)
        {
            <a href="/testcases/create?suiteId=@testSuite.Id" class="btn btn-primary btn-sm">@L["AddTestCase"]</a>
        }
    </div>

    @if (!testSuite.TestCases.Any())
    {
        <p>@L["NoTestCasesFound"]</p>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th style="width: 6%">ID</th>
                    <th>@L["Title"]</th>
                    <th style="width: 10%">@L["Priority"]</th>
                    <th style="width: 10%">@L["Status"]</th>
                    <th style="width: 18%">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tc in testSuite.TestCases.OrderBy(t => t.Id))
                {
                    <tr>
                        <td>@tc.Id</td>
                        <td>@tc.Title</td>
                        <td>
                            <span class="badge @(tc.Priority == "High" ? "bg-danger" : tc.Priority == "Medium" ? "bg-warning text-dark" : "bg-secondary")">
                                @tc.Priority
                            </span>
                        </td>
                        <td>
                            <span class="badge @(tc.Status == "Pass" ? "bg-success" : tc.Status == "Fail" ? "bg-danger" : "bg-warning text-dark")">
                                @tc.Status
                            </span>
                        </td>
                        <td>
                            <a href="/testcases/details/@tc.Id">@L["View"]</a>
                            @if (canEdit)
                            {
                                <span> | </span>
                                <a href="/testcases/edit/@tc.Id">@L["Edit"]</a>
                                <span> | </span>
                                <a href="/testcases/delete/@tc.Id">@L["Delete"]</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-4">
        <a href="/projects/details/@testSuite.TestProjectId" class="btn btn-secondary">@L["BackToProject"]</a>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TestSuite? testSuite;
    private bool canEdit = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        testSuite = await DbContext.TestSuites
            .Include(s => s.TestCases)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (testSuite == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }
}
