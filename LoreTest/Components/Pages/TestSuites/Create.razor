@page "/testsuites/create"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Create Test Suite</PageTitle>

<h1>Create Test Suite</h1>

@if (!canEdit)
{
    <p>You do not have permission to create test suites.</p>
}
else
{
    <hr />
    <div class="row">
        <div class="col-md-8">
            <EditForm Model="testSuite" OnValidSubmit="AddTestSuite" FormName="createTestSuite">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <input type="hidden" @bind="testSuite.TestProjectId" />

                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <InputText id="title" @bind-Value="testSuite.Title" class="form-control" />
                    <ValidationMessage For="() => testSuite.Title" class="text-danger" />
                </div>

                <div class="mb-3" style="margin-bottom: 60px !important;">
                    <label for="description" class="form-label">Description:</label>
                    <div @ref="editorDescription" style="height: 200px;"></div>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 60px;">Create</button>
            </EditForm>
        </div>
    </div>
}

<div class="mt-3">
    <a href="/projects/details/@ProjectId">Back to Project</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public int ProjectId { get; set; }

    [SupplyParameterFromForm]
    private TestSuite testSuite { get; set; } = new();

    private bool canEdit = false;
    private ElementReference editorDescription;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null && (user.Role == "Administrator" || user.Role == "Editor"))
        {
            canEdit = true;
        }

        if (testSuite.TestProjectId == 0)
        {
            testSuite.TestProjectId = ProjectId;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && canEdit)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (!window.quillInitialized) {
                    window.initQuill = function(element, initialContent) {
                        var quill = new Quill(element, { 
                            theme: 'snow',
                            modules: {
                                toolbar: [
                                    [{ 'header': [1, 2, 3, false] }],
                                    ['bold', 'italic', 'underline', 'strike'],
                                    ['image', 'link', 'blockquote', 'code-block'],
                                    [{ 'list': 'ordered'}, { 'list': 'bullet' }]
                                ]
                            }
                        });
                        quill.root.innerHTML = initialContent || '';
                        element.quill = quill;
                    };
                    window.getQuillContent = function(element) {
                        return element.quill ? element.quill.root.innerHTML : '';
                    };
                    window.quillInitialized = true;
                }
            ");
            await JSRuntime.InvokeVoidAsync("initQuill", editorDescription, testSuite.Description ?? "");
        }
    }

    private async Task AddTestSuite()
    {
        if (canEdit)
        {
            testSuite.Description = await JSRuntime.InvokeAsync<string>("getQuillContent", editorDescription);

            DbContext.TestSuites.Add(testSuite);
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo($"/projects/details/{testSuite.TestProjectId}");
        }
    }
}
