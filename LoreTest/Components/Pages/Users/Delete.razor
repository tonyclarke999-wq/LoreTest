@page "/users/delete/{Id}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using LoreTest.Data
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["DeleteUser"]</PageTitle>

<h1>@L["DeleteUser"]</h1>
<hr />

@if (user == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <h3>@L["DeleteConfirmation"]</h3>
    <div>
        <dl class="row mt-3">
            <dt class="col-sm-2">@L["Email"]</dt>
            <dd class="col-sm-10">@user.Email</dd>
            <dt class="col-sm-2">@L["Name"]</dt>
            <dd class="col-sm-10">@user.Name</dd>
            <dt class="col-sm-2">@L["JobTitle"]</dt>
            <dd class="col-sm-10">@user.JobTitle</dd>
            <dt class="col-sm-2">@L["Role"]</dt>
            <dd class="col-sm-10">@user.Role</dd>
        </dl>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button @onclick="DeleteUser" class="btn btn-danger">@L["Delete"]</button>
        <a href="/users" class="btn btn-secondary">@L["BackToList"]</a>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = default!;

    private ApplicationUser? user;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(Id);
        if (user == null)
        {
            NavigationManager.NavigateTo("/users");
        }
    }

    private async Task DeleteUser()
    {
        errorMessage = null;
        if (user != null)
        {
            var result = await UserManager.DeleteAsync(user);
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/users");
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
    }
}
