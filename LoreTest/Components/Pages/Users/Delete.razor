@page "/users/delete/{Id}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using LoreTest.Data
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Delete User</PageTitle>

<h1>Delete User</h1>
<hr />

@if (user == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h3>Are you sure you want to delete this user?</h3>
    <div>
        <dl class="row mt-3">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@user.Email</dd>
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@user.Name</dd>
            <dt class="col-sm-2">Job Title</dt>
            <dd class="col-sm-10">@user.JobTitle</dd>
            <dt class="col-sm-2">Role</dt>
            <dd class="col-sm-10">@user.Role</dd>
        </dl>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button @onclick="DeleteUser" class="btn btn-danger">Delete</button>
        <a href="/users" class="btn btn-secondary">Back to List</a>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = default!;

    private ApplicationUser? user;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(Id);
        if (user == null)
        {
            NavigationManager.NavigateTo("/users");
        }
    }

    private async Task DeleteUser()
    {
        errorMessage = null;
        if (user != null)
        {
            var result = await UserManager.DeleteAsync(user);
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/users");
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
    }
}
