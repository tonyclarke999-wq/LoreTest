@page "/users"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<PageTitle>@L["Users"]</PageTitle>

<h1>@L["Users"]</h1>

<p>
    <a href="/users/create" class="btn btn-primary">@L["CreateNew"]</a>
</p>

@if (users == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["Email"]</th>
                <th>@L["Name"]</th>
                <th>@L["JobTitle"]</th>
                <th>@L["Role"]</th>
                <th>@L["StartDate"]</th>
                <th>@L["EndDate"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.Name</td>
                    <td>@user.JobTitle</td>
                    <td>@user.Role</td>
                    <td>@user.StartDate?.ToString("d")</td>
                    <td>@user.EndDate?.ToString("d")</td>
                    <td>
                        <a href="/users/edit/@user.Id">@L["Edit"]</a> |
                        <a href="/users/delete/@user.Id">@L["Delete"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ApplicationUser>? users;

    protected override async Task OnInitializedAsync()
    {
        users = await UserManager.Users.ToListAsync();
    }
}
