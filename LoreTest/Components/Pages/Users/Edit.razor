@page "/users/edit/{Id}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using LoreTest.Data
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize]

<div class="headline-md mb-4">@L["EditUser"]</div>

@if (user == null)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Loading"]</span>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-xl-6">
            <div class="card p-4">
                <EditForm Model="Input" OnValidSubmit="ValidSubmit" FormName="EditUser">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label for="email" class="form-label">@L["Email"]</label>
                        <InputText id="email" @bind-Value="Input.Email" class="form-control" disabled />
                    </div>
                    <div class="mb-3">
                        <label for="name" class="form-label">@L["Name"]</label>
                        <InputText id="name" @bind-Value="Input.Name" class="form-control" />
                        <ValidationMessage For="() => Input.Name" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="jobTitle" class="form-label">@L["JobTitle"]</label>
                        <InputText id="jobTitle" @bind-Value="Input.JobTitle" class="form-control" />
                        <ValidationMessage For="() => Input.JobTitle" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="role" class="form-label">@L["Role"]</label>
                        <InputSelect id="role" @bind-Value="Input.Role" class="form-select">
                            <option value="Tester">Tester</option>
                            <option value="Editor">Editor</option>
                            <option value="Administrator">Administrator</option>
                        </InputSelect>
                        <ValidationMessage For="() => Input.Role" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="startDate" class="form-label">@L["StartDate"]</label>
                        <InputDate id="startDate" @bind-Value="Input.StartDate" class="form-control" />
                        <ValidationMessage For="() => Input.StartDate" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="endDate" class="form-label">@L["EndDate"] (Optional)</label>
                        <InputDate id="endDate" @bind-Value="Input.EndDate" class="form-control" />
                        <ValidationMessage For="() => Input.EndDate" class="text-danger" />
                    </div>
                    <div class="mb-3">
                        <label for="preferredLanguage" class="form-label">@L["PreferredLanguage"]</label>
                        <InputSelect id="preferredLanguage" @bind-Value="Input.PreferredLanguage" class="form-select">
                            <option value="en">English</option>
                            <option value="fr">Français</option>
                            <option value="de">Deutsch</option>
                            <option value="es">Español</option>
                        </InputSelect>
                        <ValidationMessage For="() => Input.PreferredLanguage" class="text-danger" />
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary d-flex align-items-center">
                            <span class="material-symbols-outlined small me-1">save</span> @L["Save"]
                        </button>
                        <a href="/users" class="btn btn-outline-secondary d-flex align-items-center">
                            <span class="material-symbols-outlined small me-1">arrow_back</span> @L["BackToList"]
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = default!;

    private InputModel Input { get; set; } = new();

    private ApplicationUser? user;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByIdAsync(Id);
        if (user == null)
        {
            NavigationManager.NavigateTo("/users");
            return;
        }

        Input.Email = user.Email ?? "";
        Input.Name = user.Name;
        Input.JobTitle = user.JobTitle;
        Input.Role = user.Role;
        Input.StartDate = user.StartDate;
        Input.EndDate = user.EndDate;
        Input.PreferredLanguage = user.PreferredLanguage;
    }

    public class InputModel : IValidatableObject
    {
        public string Email { get; set; } = "";
        public string? Name { get; set; }
        public string? JobTitle { get; set; }
        public string? Role { get; set; }
        public DateOnly? StartDate { get; set; }
        public DateOnly? EndDate { get; set; }
        public string PreferredLanguage { get; set; } = "en";

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (StartDate.HasValue && EndDate.HasValue && EndDate.Value < StartDate.Value)
            {
                yield return new ValidationResult(
                    "The end date can be empty or on or after the start date.",
                    new[] { nameof(EndDate) });
            }
        }
    }

    private async Task ValidSubmit()
    {
        errorMessage = null;

        if (user != null)
        {
            user.Name = Input.Name;
            user.JobTitle = Input.JobTitle;
            user.Role = Input.Role;
            user.StartDate = Input.StartDate;
            user.EndDate = Input.EndDate;
            user.PreferredLanguage = Input.PreferredLanguage;

            try
            {
                var result = await UserManager.UpdateAsync(user);

                if (result.Succeeded)
                {
                    NavigationManager.NavigateTo("/users");
                }
                else
                {
                    errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                }
            }
            catch (Exception ex)
            {
                errorMessage = L["ErrorUpdatingUser"] + ": " + ex.Message;
            }
        }
    }
}
