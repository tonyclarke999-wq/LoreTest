@page "/admin/settings"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using LoreTest.Data
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer

<PageTitle>@L["AdminSettings"]</PageTitle>

<h1>@L["AdminSettings"]</h1>

<hr />

@if (settings == null)
{
    <p><em>@L["Loading"]</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            @if (successMessage != null)
            {
                <div class="alert alert-success">@successMessage</div>
            }

            <EditForm Model="settings" OnValidSubmit="HandleValidSubmit" FormName="AdminSettingsForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">
                        @L["TranslationServiceSettings"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="translationApi" class="form-label">@L["TranslationAPI"]</label>
                            <InputSelect id="translationApi" @bind-Value="settings.TranslationApi" class="form-select">
                                <option value="Mock">Mock (Demo Mode)</option>
                                <option value="Google">Google Cloud Translation</option>
                                <option value="Azure">Azure Translator</option>
                                <option value="DeepL">DeepL API</option>
                            </InputSelect>
                            <div class="form-text">@L["TranslationApiHelp"]</div>
                        </div>

                        <div class="mb-3">
                            <label for="apiKey" class="form-label">@L["APIKey"]</label>
                            <InputText id="apiKey" @bind-Value="settings.TranslationApiKey" class="form-control" type="password" />
                            <div class="form-text">@L["ApiKeyHelp"]</div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">
                        @L["Internationalization"]
                    </div>
                    <div class="card-body">
                        <p>@L["ManageLanguagesAndTranslationsHelp"]</p>
                        <div class="d-flex gap-2">
                            <a href="/admin/languages" class="btn btn-outline-primary">@L["ManageLanguages"]</a>
                            <a href="/admin/translations" class="btn btn-outline-primary">@L["ManageFieldTranslations"]</a>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">
                        @L["JiraIntegration"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="jiraBaseUrl" class="form-label">@L["JiraBaseUrl"]</label>
                            <InputText id="jiraBaseUrl" @bind-Value="settings.JiraBaseUrl" class="form-control" placeholder="https://your-domain.atlassian.net" />
                        </div>
                        <div class="mb-3">
                            <label for="jiraEmail" class="form-label">@L["JiraEmail"]</label>
                            <InputText id="jiraEmail" @bind-Value="settings.JiraEmail" class="form-control" type="email" placeholder="user@domain.com" />
                            <div class="form-text">@L["JiraEmailHelp"]</div>
                        </div>
                        <div class="mb-3">
                            <label for="jiraApiToken" class="form-label">@L["JiraApiToken"]</label>
                            <InputText id="jiraApiToken" @bind-Value="settings.JiraApiToken" class="form-control" type="password" />
                            <div class="form-text">@((MarkupString)L["JiraApiTokenHelp"].Value)</div>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">
                        @L["TelemetryAndAnalytics"]
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="telemetryLevel" class="form-label">@L["TelemetryLevel"]</label>
                            <InputSelect id="telemetryLevel" @bind-Value="settings.TelemetryLevel" class="form-select">
                                <option value="None">None (No UI tracking)</option>
                                <option value="LoginOnly">Login/Logout Only</option>
                                <option value="Full">Full (Logins, logouts, page views, search, browser Info)</option>
                            </InputSelect>
                            <div class="form-text text-muted">@L["TelemetryLevelHelp"]</div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">@L["SaveSettings"]</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private AppSettings? settings;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        settings = await DbContext.AppSettings.FirstOrDefaultAsync();
        if (settings == null)
        {
            settings = new AppSettings();
            DbContext.AppSettings.Add(settings);
            await DbContext.SaveChangesAsync();
        }
    }

    private async Task HandleValidSubmit()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        settings!.LastUpdated = DateTime.UtcNow;
        settings.UpdatedBy = authState.User.Identity?.Name;

        DbContext.AppSettings.Update(settings);
        await DbContext.SaveChangesAsync();
        
        NavigationManager.NavigateTo("/");
    }
}
