{% extends 'base.html.twig' %}

{% block title %}Edit Build - Admin{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>Edit Build: {{ build.buildname }}</h1>
            <p class="subtitle">System Administration - Version Update</p>
        </div>
        <a href="{{ path('app_admin_builds', {id: build.releaseid}) }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to List</a>
    </div>
</div>

<div class="project-card" style="max-width: 800px;">
    <form method="post">
        <div class="form-group">
            <label for="name">Build Name</label>
            <input type="text" id="name" name="name" class="form-control" value="{{ build.buildname }}" required>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control" style="min-height: 120px;">{{ build.description }}</textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <a href="{{ path('app_admin_builds', {id: build.releaseid}) }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
