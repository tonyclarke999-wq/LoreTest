{% extends 'base.html.twig' %}

{% block title %}Add New Release - Admin{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>Create New Release</h1>
            <p class="subtitle">Define a new project version milestone</p>
        </div>
        <a href="{{ path('app_admin_releases') }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to List</a>
    </div>
</div>

<div class="project-card" style="max-width: 800px;">
    <form method="post">
        <div class="form-group">
            <label for="project_id">Project</label>
            <select id="project_id" name="project_id" class="form-control" required>
                {% for project in projects %}
                    <option value="{{ project.project_id }}">{{ project.project_name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="name">Release Name</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g. v1.0, Q3 Update" required>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control" style="min-height: 120px;"></textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Create Release</button>
            <a href="{{ path('app_admin_releases') }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
