{% extends 'base.html.twig' %}

{% block title %}User Management - Admin{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>User Management</h1>
            <p class="subtitle">System Administration - {{ users|length }} total users</p>
        </div>
        <a href="{{ path('app_admin_user_new') }}" class="btn-primary" style="text-decoration: none;">Add User</a>
    </div>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Admin</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td style="color: var(--primary); font-weight: 600;">#{{ user.user_id }}</td>
                <td style="font-weight: 500;">{{ user.username }}</td>
                <td>{{ user.first_name }} {{ user.last_name }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% if user.deleted == 'Y' %}
                        <span class="badge badge-red">Inactive</span>
                    {% else %}
                        <span class="badge badge-green">Active</span>
                    {% endif %}
                </td>
                <td>
                    {% if user.user_admin == 'Y' %}
                        <span class="badge badge-yellow">Admin</span>
                    {% else %}
                        <span class="badge badge-blue">User</span>
                    {% endif %}
                </td>
                <td style="display: flex; gap: 0.5rem;">
                    <a href="{{ path('app_admin_user_edit', {userId: user.user_id}) }}" class="badge badge-blue" style="text-decoration: none;">Edit</a>
                    <form action="{{ path('app_admin_user_delete', {userId: user.user_id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');" style="margin: 0;">
                        <button type="submit" class="badge badge-red" style="border: none; cursor: pointer; font-family: inherit; font-size: inherit;">Delete</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
