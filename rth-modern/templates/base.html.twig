<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/global.css') }}">
            <style>
                .material-symbols-outlined {
                    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                    vertical-align: middle;
                }
                .top-navbar {
                    position: fixed;
                    top: 0;
                    width: 100%;
                    height: 3.5rem;
                    background: var(--surface-low);
                    border-bottom: 1px solid var(--glass-border);
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    padding: 0 1.5rem;
                    z-index: 50;
                }
                .top-navbar .logo {
                    font-size: 24px;
                    font-weight: 700;
                    color: #ffffff;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }
                .top-nav-btn {
                    background: none;
                    border: none;
                    cursor: pointer;
                    color: var(--text-muted);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    transition: var(--transition);
                    text-decoration: none;
                }
                .top-nav-btn:hover {
                    background: rgba(255, 255, 255, 0.08);
                    color: var(--text-main);
                }
                .app-wrapper {
                    display: flex;
                    width: 100%;
                    margin-top: 3.5rem;
                    min-height: calc(100vh - 3.5rem);
                }
                .sidebar {
                    height: calc(100vh - 3.5rem);
                }
            </style>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
        <!-- Hotwire Turbo Drive for SPA-like instant page transitions -->
        <script type="module" src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.4/dist/turbo.es2017-umd.js"></script>
        <!-- instant.page for 0ms hover prefetching -->
        <script src="https://cdn.jsdelivr.net/npm/instant.page@5.2.0/instantpage.js" type="module" defer></script>
    </head>
    <body>
        <header class="top-navbar">
            <div style="display: flex; align-items: center; gap: 2rem;">
                <a href="{{ path('app_home') }}" class="logo">
                    <span>RTH</span>
                    <span style="font-size: 11px; font-weight: 600; padding: 2px 6px; background: var(--primary-container); color: var(--on-primary); border-radius: var(--radius-sm); letter-spacing: 0.02em; text-transform: uppercase;">Modern</span>
                </a>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <button class="top-nav-btn" title="No new notifications">
                    <span class="material-symbols-outlined" style="font-size: 20px;">notifications</span>
                </button>
                <a href="{{ path('app_profile') }}" class="top-nav-btn" title="User Profile & Settings">
                    <span class="material-symbols-outlined" style="font-size: 20px;">settings</span>
                </a>
            </div>
        </header>
        <div class="app-wrapper">
            {% block sidebar %}{% endblock %}
            <main class="main-content">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
