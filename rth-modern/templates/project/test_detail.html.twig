{% extends 'base.html.twig' %}

{% block title %}Test Case #{{ test.testid }} - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                <span class="badge badge-purple" style="font-size: 0.9rem; padding: 0.25rem 0.6rem;">TC #{{ test.testid }}</span>
                {% set status_class = 'badge-yellow' %}
                {% if test.status == 'Passed' or test.status == 'Completed' %}{% set status_class = 'badge-green' %}
                {% elseif test.status == 'Failed' %}{% set status_class = 'badge-red' %}
                {% elseif test.status == 'Ready' %}{% set status_class = 'badge-blue' %}
                {% elseif test.status == 'Retired' %}{% set status_class = 'badge-red' %}
                {% endif %}
                <span class="badge {{ status_class }}">{{ test.status }}</span>

                {% set priority_class = 'badge-blue' %}
                {% if test.priority == 'High' %}{% set priority_class = 'badge-red' %}
                {% elseif test.priority == 'Medium' %}{% set priority_class = 'badge-yellow' %}
                {% endif %}
                <span class="badge {{ priority_class }}">{{ test.priority }}</span>
            </div>
            <h1>{{ test.testsuitename }}</h1>
            <p class="subtitle">Test Case Asset for {{ project.project_name }}</p>
        </div>
        <div style="display: flex; gap: 0.5rem;">
            <a href="{{ path('app_project_tests', {id: project.project_id}) }}" class="badge badge-blue" style="text-decoration: none;">Back to List</a>
            <a href="{{ path('app_project_test_edit', {id: project.project_id, testId: test.testid}) }}" class="badge badge-blue" style="text-decoration: none;">Edit</a>
            <a href="{{ path('app_project_test_steps', {id: project.project_id, testId: test.testid}) }}" class="badge badge-green" style="text-decoration: none;">Steps</a>
            {% if test.status != 'Retired' %}
            <form action="{{ path('app_project_test_retire', {id: project.project_id, testId: test.testid}) }}" method="post" style="margin: 0; display: inline;">
                <button type="submit" class="badge badge-red" style="border: none; cursor: pointer; background: rgba(239, 68, 68, 0.1);">Retire</button>
            </form>
            {% endif %}
            <form action="{{ path('app_project_test_delete', {id: project.project_id, testId: test.testid}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this test case?');" style="margin: 0; display: inline;">
                <button type="submit" class="badge badge-red" style="border: none; cursor: pointer;">Delete</button>
            </form>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
    {# Left Column: Overview, Narrative & Comments #}
    <div style="display: flex; flex-direction: column; gap: 2rem;">
        <div class="project-card" style="cursor: default;">
            <h2 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 1rem;">Test Purpose</h2>
            <div class="description-box" style="background: rgba(255,255,255,0.03); padding: 1.25rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); white-space: pre-wrap; color: var(--text-color);">{{ test.purpose|default('No purpose specified.') }}</div>
        </div>

        <div class="project-card" style="cursor: default;">
            <h2 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 1rem;">Comments & Notes</h2>
            <div class="description-box" style="background: rgba(255,255,255,0.03); padding: 1.25rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); white-space: pre-wrap; color: var(--text-color);">{{ test.comments|default('No comments recorded.') }}</div>
        </div>

        <div class="project-card" style="cursor: default;">
            <h2 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 1rem;">Execution Parameters</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">Manual Steps:</span>
                    <span class="badge {% if test.steps == 'Y' %}badge-green{% else %}badge-red{% endif %}">{% if test.steps == 'Y' %}Yes{% else %}No{% endif %}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">Automated Script:</span>
                    <span class="badge {% if test.script == 'Y' %}badge-green{% else %}badge-red{% endif %}">{% if test.script == 'Y' %}Yes{% else %}No{% endif %}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">LoadRunner:</span>
                    <span class="badge {% if test.loadrunner == 'Y' %}badge-green{% else %}badge-red{% endif %}">{% if test.loadrunner == 'Y' %}Yes{% else %}No{% endif %}</span>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">Auto Pass:</span>
                    <span class="badge {% if test.autopass == 'Y' %}badge-green{% else %}badge-red{% endif %}">{% if test.autopass == 'Y' %}Yes{% else %}No{% endif %}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">Email BA Owner:</span>
                    <span class="badge {% if test.email_ba_owner == 'Y' %}badge-green{% else %}badge-red{% endif %}">{% if test.email_ba_owner == 'Y' %}Yes{% else %}No{% endif %}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.02); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: var(--text-muted); font-size: 0.9rem;">Email QA Owner:</span>
                    <span class="badge {% if test.email_qa_owner == 'Y' %}badge-green{% else %}badge-red{% endif %}">{% if test.email_qa_owner == 'Y' %}Yes{% else %}No{% endif %}</span>
                </div>
            </div>
        </div>
    </div>

    {# Right Column: Metadata, Roles, Schedule #}
    <div style="display: flex; flex-direction: column; gap: 2rem;">
        <div class="project-card" style="cursor: default;">
            <h2 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 1rem;">Categorization</h2>
            <table class="detail-table">
                <tbody>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Test Type</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.testtype|default('—') }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Test Area</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.areatested|default('—') }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="project-card" style="cursor: default;">
            <h2 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 1rem;">Ownership & Roles</h2>
            <table class="detail-table">
                <tbody>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">BA Owner</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.baowner ? test.baowner : 'Unassigned' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">QA Owner (Scripter)</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.scripter ? test.scripter : 'Unassigned' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Tester</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.tester ? test.tester : 'Unassigned' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Assigned To</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.assignedto ? test.assignedto : 'Unassigned' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Assigned By</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.assignedby ? test.assignedby : 'Unassigned' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="project-card" style="cursor: default;">
            <h2 style="font-size: 1.15rem; color: var(--primary); margin-bottom: 1rem;">Schedule & Effort</h2>
            <table class="detail-table">
                <tbody>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Date Assigned</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.dateassigned ? test.dateassigned : '—' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Expected Complete</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.expdatecomplete ? test.expdatecomplete : '—' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Actual Complete</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.actdatecomplete ? test.actdatecomplete : '—' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Duration</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.duration ? test.duration ~ ' mins' : '—' }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">Last Updated By</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">{{ test.lastupdatedby }}</td>
                    </tr>
                    <tr>
                        <td class="label" style="color: var(--text-muted); padding: 0.5rem 0;">Last Updated</td>
                        <td style="font-weight: 500; text-align: right; padding: 0.5rem 0;">{{ test.lastupdated|date('Y-m-d H:i') }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
