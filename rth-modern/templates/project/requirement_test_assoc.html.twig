{% extends 'base.html.twig' %}

{% block title %}Test Associations - Requirement #{{ requirement.reqid }} - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>Test Associations</h1>
            <p class="subtitle">Requirement #{{ requirement.reqid }} — {{ requirement.reqname }}</p>
        </div>
        <a href="{{ path('app_project_requirement_detail', {id: project.project_id, reqId: requirement.reqid}) }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to Detail</a>
    </div>
</div>

<div class="project-card" style="max-width: 1000px; cursor: default;">
    <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem;">
        Check the tests to associate with this requirement and specify the % coverage for each. Unchecked tests will be disassociated.
    </p>

    <form method="post">
        {% if allTests|length > 0 %}
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th width="50">Link</th>
                        <th width="100">% Covered</th>
                        <th>Test ID</th>
                        <th>Test Name</th>
                    </tr>
                </thead>
                <tbody>
                    {% for test in allTests %}
                    {% set isAssociated = test.testid in assocMap|keys %}
                    <tr {% if isAssociated %}style="background: rgba(34, 197, 94, 0.06);"{% endif %}>
                        <td>
                            <input type="checkbox" name="test_ids[]" value="{{ test.testid }}" id="test_{{ test.testid }}"
                                {% if isAssociated %}checked{% endif %}
                                style="width: 18px; height: 18px; cursor: pointer;">
                        </td>
                        <td>
                            <input type="number" name="percent_covered[{{ test.testid }}]"
                                value="{{ assocMap[test.testid]|default(0) }}"
                                min="0" max="100" class="form-control"
                                style="width: 70px; padding: 0.375rem 0.5rem; text-align: center; font-size: 0.85rem;">
                        </td>
                        <td>
                            <a href="{{ path('app_project_test_steps', {id: project.project_id, testId: test.testid}) }}" style="color: var(--primary); text-decoration: none;">#{{ test.testid }}</a>
                        </td>
                        <td>{{ test.testsuitename }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; align-items: center;">
            <button type="submit" class="btn-primary">Save Associations</button>
            <a href="{{ path('app_project_requirement_detail', {id: project.project_id, reqId: requirement.reqid}) }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-muted); font-size: 0.85rem; margin-left: auto;">
                <input type="checkbox" id="selectAll" onclick="toggleAll(this)"> Select All
            </label>
        </div>
        {% else %}
        <div class="empty-state">
            <p>No tests found in this project.</p>
        </div>
        {% endif %}
    </form>
</div>

<script>
function toggleAll(source) {
    const checkboxes = document.querySelectorAll('input[name="test_ids[]"]');
    checkboxes.forEach(cb => cb.checked = source.checked);
}
</script>
{% endblock %}
