{% extends 'base.html.twig' %}

{% block title %}Edit Requirement - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>Edit Requirement #{{ requirement.reqid }}</h1>
            <p class="subtitle">Updating requirement for {{ project.project_name }}</p>
        </div>
        <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to List</a>
    </div>
</div>

<div class="project-card" style="max-width: 800px;">
    <form method="post">
        <div class="form-group">
            <label for="name">Requirement Name</label>
            <input type="text" id="name" name="name" class="form-control" value="{{ requirement.reqname }}" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control" required>
                    <option value="High" {% if requirement.priority == 'High' %}selected{% endif %}>High</option>
                    <option value="Medium" {% if requirement.priority == 'Medium' %}selected{% endif %}>Medium</option>
                    <option value="Low" {% if requirement.priority == 'Low' %}selected{% endif %}>Low</option>
                </select>
            </div>
            <div class="form-group">
                <label for="type">Requirement Type</label>
                <select id="type" name="type" class="form-control" required>
                    <option value="1" {% if requirement.type == 1 %}selected{% endif %}>Use Case</option>
                    <option value="2" {% if requirement.type == 2 %}selected{% endif %}>Functional Spec</option>
                    <option value="3" {% if requirement.type == 3 %}selected{% endif %}>Technical Spec</option>
                </select>
            </div>
            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control" required>
                    <option value="Draft" {% if requirement.status == 'Draft' %}selected{% endif %}>Draft</option>
                    <option value="New" {% if requirement.status == 'New' %}selected{% endif %}>New</option>
                    <option value="Approved" {% if requirement.status == 'Approved' %}selected{% endif %}>Approved</option>
                    <option value="Rejected" {% if requirement.status == 'Rejected' %}selected{% endif %}>Rejected</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label for="detail">Detailed Description (v{{ requirement.version }})</label>
            <textarea id="detail" name="detail" class="form-control" style="min-height: 200px;">{{ requirement.detail }}</textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
