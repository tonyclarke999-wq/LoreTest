{% extends 'base.html.twig' %}

{% block title %}Requirements - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>Requirements</h1>
            <p class="subtitle">Managing {{ requirements|length }} requirements for {{ project.project_name }}</p>
        </div>
        <div style="display: flex; gap: 1rem; align-items: center;">
            <form method="get" style="display: flex; gap: 0.5rem;">
                <input type="text" name="q" value="{{ search }}" class="form-control" placeholder="Search requirements..." style="padding: 0.5rem 1rem; width: 250px; font-size: 0.875rem;">
                {% if search %}
                    <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="badge badge-red" style="text-decoration: none; display: flex; align-items: center;">Clear</a>
                {% endif %}
            </form>
            <a href="{{ path('app_project_requirement_new', {id: project.project_id}) }}" class="btn-primary" style="text-decoration: none; padding: 0.5rem 1rem; font-size: 0.875rem;">Add Requirement</a>
        </div>
    </div>
</div>

<div class="table-container">
    {% if requirements|length > 0 %}
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Version</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Area</th>
                <th>Author</th>
                <th>Locked By</th>
                <th width="150">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for req in requirements %}
            <tr>
                <td style="color: var(--primary); font-family: 'JetBrains Mono', monospace; font-size: 12px;">
                    <a href="{{ path('app_project_requirement_detail', {id: project.project_id, reqId: req.reqid}) }}" style="color: var(--primary); text-decoration: none;">REQ-{{ req.reqid }}</a>
                </td>
                <td style="font-weight: 500;">
                    <a href="{{ path('app_project_requirement_detail', {id: project.project_id, reqId: req.reqid}) }}" style="color: var(--text-main); text-decoration: none;">
                        {% if req.recordorfile == 'F' %}<span class="material-symbols-outlined" style="font-size: 16px; margin-right: 4px; color: var(--text-muted);">description</span>{% endif %}{{ req.reqname }}
                    </a>
                </td>
                <td>
                    {% if req.doc_type_name %}
                        <span class="badge badge-purple">{{ req.doc_type_name }}</span>
                    {% endif %}
                </td>
                <td><span class="badge badge-blue">v{{ req.version|default('1.0') }}</span></td>
                <td>
                    {% set status_class = 'badge-yellow' %}
                    {% if req.status == 'Approved' %}{% set status_class = 'badge-green' %}
                    {% elseif req.status == 'Draft' %}{% set status_class = 'badge-blue' %}
                    {% elseif req.status == 'Rejected' %}{% set status_class = 'badge-red' %}
                    {% endif %}
                    <span class="badge {{ status_class }}">{{ req.status|default('Draft') }}</span>
                </td>
                <td>
                    {% set priority_class = 'badge-yellow' %}
                    {% if req.priority == 'High' %}{% set priority_class = 'badge-red' %}
                    {% elseif req.priority == 'Low' %}{% set priority_class = 'badge-blue' %}
                    {% endif %}
                    <span class="badge {{ priority_class }}">{{ req.priority|default('Medium') }}</span>
                </td>
                <td style="color: var(--text-muted); font-size: 13px;">{{ req.area_name|default('—') }}</td>
                <td style="color: var(--text-muted); font-size: 13px;">{{ req.author|default('System') }}</td>
                <td>
                    {% if req.lockedby %}
                        <span class="badge badge-red"><span class="material-symbols-outlined" style="font-size: 12px; margin-right: 2px;">lock</span> {{ req.lockedby }}</span>
                    {% endif %}
                </td>
                <td style="display: flex; gap: 0.5rem; align-items: center; justify-content: flex-end;">
                    <a href="{{ path('app_project_requirement_detail', {id: project.project_id, reqId: req.reqid}) }}" style="color: var(--text-muted); transition: color 0.2s;" title="View">
                        <span class="material-symbols-outlined hover:text-primary">visibility</span>
                    </a>
                    <a href="{{ path('app_project_requirement_edit', {id: project.project_id, reqId: req.reqid}) }}" style="color: var(--text-muted); transition: color 0.2s;" title="Edit">
                        <span class="material-symbols-outlined hover:text-warning">edit</span>
                    </a>
                    <form action="{{ path('app_project_requirement_delete', {id: project.project_id, reqId: req.reqid}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this requirement?');" style="margin: 0;">
                        <button type="submit" style="background: none; border: none; cursor: pointer; color: var(--text-muted); transition: color 0.2s;" title="Delete">
                            <span class="material-symbols-outlined hover:text-danger">delete</span>
                        </button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <div class="empty-state">
        <p>No requirements found for this project.</p>
    </div>
    {% endif %}
</div>
{% endblock %}
