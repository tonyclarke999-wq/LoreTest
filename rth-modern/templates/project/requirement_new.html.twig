{% extends 'base.html.twig' %}

{% block title %}New Requirement - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>New Requirement</h1>
            <p class="subtitle">Creating a new requirement for {{ project.project_name }}</p>
        </div>
        <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to List</a>
    </div>
</div>

<div class="project-card" style="max-width: 800px;">
    <form method="post">
        <div class="form-group">
            <label for="name">Requirement Name</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g., User Login Authentication" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control" required>
                    <option value="High">High</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
            <div class="form-group">
                <label for="type">Requirement Type</label>
                <select id="type" name="type" class="form-control" required>
                    <option value="1">Use Case</option>
                    <option value="2">Functional Spec</option>
                    <option value="3" selected>Technical Spec</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label for="detail">Detailed Description</label>
            <textarea id="detail" name="detail" class="form-control" style="min-height: 200px;" placeholder="Describe the requirement in detail..."></textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Create Requirement</button>
            <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
