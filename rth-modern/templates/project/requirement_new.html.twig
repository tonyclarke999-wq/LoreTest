{% extends 'base.html.twig' %}

{% block title %}New Requirement - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>New Requirement</h1>
            <p class="subtitle">Creating a new requirement for {{ project.project_name }}</p>
        </div>
        <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to List</a>
    </div>
</div>

<div class="project-card" style="max-width: 900px;">
    <form method="post" enctype="multipart/form-data">
        {# --- Row 1: Name --- #}
        <div class="form-group">
            <label for="name">Requirement Name <span style="color: #f87171;">*</span></label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g., User Login Authentication" required>
        </div>

        {# --- Row 2: Record or File toggle --- #}
        <div class="form-group">
            <label>Requirement Content Type</label>
            <div style="display: flex; gap: 1.5rem; margin-top: 0.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-main);">
                    <input type="radio" name="record_or_file" value="R" checked onchange="toggleContentType()"> 📝 Record (text description)
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-main);">
                    <input type="radio" name="record_or_file" value="F" onchange="toggleContentType()"> 📄 File Upload
                </label>
            </div>
        </div>

        {# --- Detail (shown for Record type) --- #}
        <div class="form-group" id="detail-group">
            <label for="detail">Detailed Description</label>
            <textarea id="detail" name="detail" class="form-control" style="min-height: 150px;" placeholder="Describe the requirement in detail..."></textarea>
        </div>

        {# --- File upload (shown for File type) --- #}
        <div class="form-group" id="file-group" style="display: none;">
            <label for="upload_file">Upload File <span style="color: #f87171;">*</span></label>
            <input type="file" id="upload_file" name="upload_file" class="form-control" style="padding: 0.5rem;">
            <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Max file size: 25MB</p>
        </div>

        {# --- Row 3: Priority, Type, Status --- #}
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control" required>
                    <option value="High">High</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>
            <div class="form-group">
                <label for="type">Document Type</label>
                <select id="type" name="type" class="form-control">
                    <option value="0">— Select —</option>
                    {% for dt in docTypes %}
                        <option value="{{ dt.reqdoctypeid }}">{{ dt.reqdoctypename }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control" required>
                    <option value="New" selected>New</option>
                    <option value="Draft">Draft</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Not Testable">Not Testable</option>
                    <option value="Obsolete">Obsolete</option>
                </select>
            </div>
        </div>

        {# --- Row 4: Area Covered, Version, Assigned To --- #}
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label for="area_covered">Area Covered</label>
                <select id="area_covered" name="area_covered" class="form-control">
                    <option value="0">— None —</option>
                    {% for area in areas %}
                        <option value="{{ area.reqareacoverageid }}">{{ area.areacoverage }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="version">Version</label>
                <input type="text" id="version" name="version" class="form-control" value="1.0" maxlength="10" style="width: 100px;">
            </div>
            <div class="form-group">
                <label for="assigned_to">Assigned To</label>
                <select id="assigned_to" name="assigned_to" class="form-control">
                    <option value="">— Unassigned —</option>
                    {% for user in users %}
                        <option value="{{ user.username }}">{{ user.username }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        {# --- Row 5: Assign to Release, Parent Requirement, Change Request --- #}
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label for="assign_release">Assign to Release</label>
                <select id="assign_release" name="assign_release" class="form-control">
                    <option value="0">— None —</option>
                    {% for rel in releases %}
                        <option value="{{ rel.releaseid }}">{{ rel.releasename }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="parent_req">Parent Requirement</label>
                <select id="parent_req" name="parent_req" class="form-control">
                    <option value="0">— None (top level) —</option>
                    {% for req in allRequirements %}
                        <option value="{{ req.reqid }}">#{{ req.reqid }} — {{ req.reqname }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group">
                <label for="defect_id">Change Request / Defect ID</label>
                <input type="number" id="defect_id" name="defect_id" class="form-control" value="0" min="0" placeholder="Bug ID">
            </div>
        </div>

        {# --- Row 6: Functionality (multi-select) --- #}
        {% if functionalities|length > 0 %}
        <div class="form-group">
            <label for="functionality">Functionality <span style="font-size: 0.75rem; color: var(--text-muted);">(Hold Ctrl/Cmd to select multiple)</span></label>
            <select id="functionality" name="functionality[]" class="form-control" multiple style="min-height: 120px;">
                {% for func in functionalities %}
                    <option value="{{ func.functionalityid }}">{{ func.functionalityname }}</option>
                {% endfor %}
            </select>
        </div>
        {% endif %}

        {# --- Row 7: Reason for Change --- #}
        <div class="form-group">
            <label for="reason_for_change">Reason for Change</label>
            <textarea id="reason_for_change" name="reason_for_change" class="form-control" style="min-height: 80px;" placeholder="Why is this requirement being created..."></textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Create Requirement</button>
            <a href="{{ path('app_project_requirements', {id: project.project_id}) }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>

<script>
function toggleContentType() {
    const isRecord = document.querySelector('input[name="record_or_file"][value="R"]').checked;
    document.getElementById('detail-group').style.display = isRecord ? 'block' : 'none';
    document.getElementById('file-group').style.display = isRecord ? 'none' : 'block';
}
</script>
{% endblock %}
