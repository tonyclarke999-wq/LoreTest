{% extends 'base.html.twig' %}

{% block title %}Edit Bug - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1>Edit Bug #{{ bug.bugid }}</h1>
            <p class="subtitle">Updating defect details for {{ project.project_name }}</p>
        </div>
        <a href="{{ path('app_project_bugs', {id: project.project_id}) }}" class="badge badge-blue" style="text-decoration: none; margin-bottom: 0.5rem;">Back to List</a>
    </div>
</div>

<div class="project-card" style="max-width: 800px;">
    <form method="post">
        <div class="form-group">
            <label for="summary">Bug Summary</label>
            <input type="text" id="summary" name="summary" class="form-control" value="{{ bug.summary }}" required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority" class="form-control" required>
                    <option value="Immediate" {% if bug.priority == 'Immediate' %}selected{% endif %}>Immediate</option>
                    <option value="High" {% if bug.priority == 'High' %}selected{% endif %}>High</option>
                    <option value="Medium" {% if bug.priority == 'Medium' %}selected{% endif %}>Medium</option>
                    <option value="Low" {% if bug.priority == 'Low' %}selected{% endif %}>Low</option>
                </select>
            </div>
            <div class="form-group">
                <label for="severity">Severity</label>
                <select id="severity" name="severity" class="form-control" required>
                    <option value="Blocker" {% if bug.severity == 'Blocker' %}selected{% endif %}>Blocker</option>
                    <option value="Critical" {% if bug.severity == 'Critical' %}selected{% endif %}>Critical</option>
                    <option value="Major" {% if bug.severity == 'Major' %}selected{% endif %}>Major</option>
                    <option value="Minor" {% if bug.severity == 'Minor' %}selected{% endif %}>Minor</option>
                    <option value="Trivial" {% if bug.severity == 'Trivial' %}selected{% endif %}>Trivial</option>
                </select>
            </div>
            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" class="form-control" required>
                    <option value="New" {% if bug.status == 'New' %}selected{% endif %}>New</option>
                    <option value="Confirmed" {% if bug.status == 'Confirmed' %}selected{% endif %}>Confirmed</option>
                    <option value="Resolved" {% if bug.status == 'Resolved' %}selected{% endif %}>Resolved</option>
                    <option value="Closed" {% if bug.status == 'Closed' %}selected{% endif %}>Closed</option>
                    <option value="Reopened" {% if bug.status == 'Reopened' %}selected{% endif %}>Reopened</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label for="description">Detailed Description & Steps to Reproduce</label>
            <textarea id="description" name="description" class="form-control" style="min-height: 200px;">{{ bug.description }}</textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <a href="{{ path('app_project_bugs', {id: project.project_id}) }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
