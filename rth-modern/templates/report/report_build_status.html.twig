{% extends 'base.html.twig' %}

{% block title %}Build Status Report - {{ project.project_name }}{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header" style="margin-bottom: 2rem;">
    <div>
        <h1>Build Status Report</h1>
        <p class="subtitle">View the status of all tests for a selected Build.</p>
    </div>
</div>

{{ include('report/_filters.html.twig', { filter_type: 'build' }) }}

{% if selected_build %}
    <div class="table-container">
        <table style="width: 100%; text-align: left; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="background: rgba(15, 23, 42, 0.6); padding: 1rem 1.25rem; font-size: var(--text-sm); color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--glass-border);">Test Set</th>
                    <th style="background: rgba(15, 23, 42, 0.6); padding: 1rem 1.25rem; font-size: var(--text-sm); color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--glass-border);">Test Case</th>
                    <th style="background: rgba(15, 23, 42, 0.6); padding: 1rem 1.25rem; font-size: var(--text-sm); color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--glass-border);">Status</th>
                    <th style="background: rgba(15, 23, 42, 0.6); padding: 1rem 1.25rem; font-size: var(--text-sm); color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--glass-border);">Assigned To</th>
                    <th style="background: rgba(15, 23, 42, 0.6); padding: 1rem 1.25rem; font-size: var(--text-sm); color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--glass-border);">Executed On</th>
                </tr>
            </thead>
            <tbody>
                {% for row in results %}
                <tr style="border-bottom: 1px solid var(--glass-border);">
                    <td style="padding: 1rem 1.25rem; color: var(--text-main);">{{ row.testsetname }}</td>
                    <td style="padding: 1rem 1.25rem; color: var(--text-main);">{{ row.testsuitename }}</td>
                    <td style="padding: 1rem 1.25rem;">
                        {% if row.teststatus == 'Passed' %}
                            <span class="badge badge-green">{{ row.teststatus }}</span>
                        {% elseif row.teststatus == 'Failed' %}
                            <span class="badge badge-red">{{ row.teststatus }}</span>
                        {% elseif row.teststatus == 'WIP' %}
                            <span class="badge badge-yellow">{{ row.teststatus }}</span>
                        {% else %}
                            <span class="badge badge-blue">{{ row.teststatus ?: 'Not Started' }}</span>
                        {% endif %}
                    </td>
                    <td style="padding: 1rem 1.25rem; color: var(--text-main);">{{ row.assignedto ?: 'Unassigned' }}</td>
                    <td style="padding: 1rem 1.25rem; color: var(--text-main);">{{ row.logtimestamp|date('Y-m-d H:i') }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-muted);">No results found for this build.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

{% endblock %}
