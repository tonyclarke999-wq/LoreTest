{% extends 'base.html.twig' %}

{% block title %}User Profile - RTH Modern{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
<div class="page-header">
    <h1>User Profile</h1>
    <p class="subtitle">Manage your account settings and security</p>
</div>

<div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem; align-items: start;">
    <!-- Profile Info -->
    <div class="project-card">
        <h2>Account Info</h2>
        <div style="margin-top: 1.5rem;">
            <div style="margin-bottom: 1rem;">
                <span style="color: var(--text-muted); font-size: 0.875rem;">Username</span>
                <p style="font-weight: 600; font-size: 1.125rem;">{{ user.username }}</p>
            </div>
            <div style="margin-bottom: 1rem;">
                <span style="color: var(--text-muted); font-size: 0.875rem;">Full Name</span>
                <p style="font-weight: 500;">{{ user.firstName }} {{ user.lastName }}</p>
            </div>
            <div style="margin-bottom: 1rem;">
                <span style="color: var(--text-muted); font-size: 0.875rem;">Email Address</span>
                <p style="font-weight: 500;">{{ user.email }}</p>
            </div>
            <div>
                <span style="color: var(--text-muted); font-size: 0.875rem;">Role</span>
                <p><span class="badge badge-blue">{{ user.userAdmin == 'Y' ? 'Administrator' : 'Standard User' }}</span></p>
            </div>
        </div>
    </div>

    <!-- Password Update -->
    <div class="project-card">
        <h2>Update Password</h2>
        <div style="margin-top: 1.5rem;">
            {% if error %}
                <div class="alert alert-error">{{ error }}</div>
            {% endif %}
            {% if success %}
                <div class="alert alert-success">{{ success }}</div>
            {% endif %}

            <form method="post">
                <div class="form-group">
                    <label for="current_password">Current Password</label>
                    <input type="password" id="current_password" name="current_password" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="new_password">New Password</label>
                    <input type="password" id="new_password" name="new_password" class="form-control" required minlength="6">
                </div>
                <div class="form-group">
                    <label for="confirm_password">Confirm New Password</label>
                    <input type="password" id="confirm_password" name="confirm_password" class="form-control" required minlength="6">
                </div>
                <div style="margin-top: 2rem;">
                    <button type="submit" class="btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
