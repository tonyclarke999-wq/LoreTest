{% extends 'base.html.twig' %}

{% block title %}Edit Project - {{ project.project_name }}{% endblock %}

{% block body %}
<div class="dashboard-container" style="max-width: 800px; margin: 4rem auto;">
    <div class="welcome-header">
        <h1>Edit Project</h1>
        <p class="subtitle">Updating details for {{ project.project_name }}</p>
    </div>

    <div class="project-card" style="padding: 2.5rem;">
        <form method="post">
            <div class="form-group">
                <label for="name">Project Name</label>
                <input type="text" id="name" name="name" class="form-control" value="{{ project.project_name }}" required>
            </div>

            <div class="form-group">
                <label for="description">Project Description</label>
                <textarea id="description" name="description" class="form-control" style="min-height: 150px;">{{ project.description }}</textarea>
            </div>

            <div style="margin-top: 2rem; display: flex; gap: 1rem;">
                <button type="submit" class="btn-primary">Save Changes</button>
                <a href="{{ path('app_home') }}" class="btn-primary" style="background: rgba(255,255,255,0.05); color: var(--text-muted); text-decoration: none;">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
