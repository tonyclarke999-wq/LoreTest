{% extends 'base.html.twig' %}

{% block title %}Project Selection{% endblock %}

{% block sidebar %}
    {{ include('project/_sidebar.html.twig') }}
{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Welcome back, {{ app.user.username }}</h1>
            <p class="subtitle">Please select a project to manage</p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_project_new') }}" class="btn-primary" style="text-decoration: none; padding: 0.5rem 1rem; font-size: 0.875rem;">Add Project</a>
        {% endif %}
    </div>

    <div class="project-grid">
        {% for project in projects %}
            <div class="project-card" style="position: relative; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
                <div>
                    <a href="{{ path('app_project_show', {id: project.project_id}) }}" style="text-decoration: none; color: inherit;">
                        <h2>{{ project.project_name }}</h2>
                        <p>{{ project.description|default('No description provided for this project.') }}</p>
                    </a>
                    <div class="stats">
                        <span>Active</span>
                        <span>•</span>
                        <span>v1.0</span>
                    </div>
                </div>
                
                {% if is_granted('ROLE_ADMIN') %}
                    <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem;">
                        <a href="{{ path('app_project_edit', {id: project.project_id}) }}" class="badge badge-blue" style="text-decoration: none;">Edit</a>
                        <form action="{{ path('app_project_delete', {id: project.project_id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this project?');" style="margin: 0;">
                            <button type="submit" class="badge badge-red" style="border: none; cursor: pointer; font-family: inherit; font-size: inherit;">Delete</button>
                        </form>
                    </div>
                {% endif %}
            </div>
        {% else %}
            <p>No projects found. Please contact an administrator.</p>
        {% endfor %}
    </div>
{% endblock %}
